---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PriceHighlight from '../components/PriceHighlight.astro';
import { SITE, LAST_UPDATED } from '../consts';

const title = 'ご予約｜岐阜市長良のパーソナルストレッチ｜全力ストレッチ岐阜長良店';
const description = '全力ストレッチ岐阜長良店のご予約。ホットペッパー・LINE・お電話から。初回限定75%OFF。完全個室・マンツーマン、岐阜市長良。';

const methods = [
  { t: 'ホットペッパービューティー', d: '24時間WEB予約。空き状況を見てそのまま予約できます。', href: SITE.urls.reserve, cta: 'HPBで予約する', primary: true },
  { t: 'LINEで相談・予約', d: `友だち追加（${SITE.urls.lineHandle}）から、気軽にメッセージでご相談・ご予約。`, href: SITE.urls.line, cta: 'LINEを開く', primary: false },
  { t: 'お電話', d: `${SITE.hours}／${SITE.tel}。ご不明点もお気軽に。`, href: `tel:${SITE.telLink}`, cta: '電話をかける', primary: false },
];

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'ご予約', item: new URL('/reserve', Astro.site).href },
  ],
};
---
<Base title={title} description={description} path="/reserve" jsonld={[breadcrumb]}>
  <Breadcrumbs items={[{ label: 'ホーム', href: '/' }, { label: 'ご予約' }]} />
  <header class="container-x pt-8 pb-10">
    <p class="eyebrow">RESERVE</p>
    <h1 class="mt-3 text-3xl font-black sm:text-4xl">ご予約について</h1>
    <p class="prose-jp mt-5 max-w-2xl">
      ご予約は、ホットペッパービューティー・LINE・お電話から承ります。
      初めての方は<span class="marker">初回限定75%OFF</span>でご体験いただけます。
      完全個室・マンツーマンなので、人目を気にせずリラックスしてお過ごしください。
    </p>
  </header>

  <section class="container-x pb-10">
    <div class="grid gap-5 md:grid-cols-3">
      {methods.map((m) => (
        <div class="flex flex-col rounded-2xl border border-line p-7">
          <p class="font-heading text-lg font-bold">{m.t}</p>
          <p class="mt-3 flex-1 text-sm text-charcoal">{m.d}</p>
          <a href={m.href} target={m.href.startsWith('tel:') ? undefined : '_blank'} rel="noopener" class={`mt-6 ${m.primary ? 'btn-amber' : 'btn-outline'}`}>{m.cta}</a>
        </div>
      ))}
    </div>
  </section>

  <section class="container-x py-10">
    <PriceHighlight />
  </section>

  <section class="container-x pb-16">
    <p class="eyebrow">BEFORE YOUR VISIT</p>
    <h2 class="mt-2 text-2xl font-bold sm:text-3xl">ご来店前のご案内</h2>
    <ul class="prose-jp mt-6 max-w-3xl list-none space-y-2">
      <li>・動きやすい服装でお越しください（お着替えの用意については{`{{着替え_貸出}}`}）。</li>
      <li>・お車の方は、ビル東側の共同駐車場（10台以上）をご利用ください。</li>
      <li>・体調やお悩みは、カウンセリングで遠慮なくお聞かせください。</li>
      <li>・キャンセル・変更のご連絡は、お早めにお願いします（{`{{キャンセルポリシー}}`}）。</li>
    </ul>
    <p class="mt-8 text-xs text-charcoal/60">最終更新：{LAST_UPDATED}</p>
  </section>
</Base>
