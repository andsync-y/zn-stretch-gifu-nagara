---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PriceRows from '../components/PriceRows.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import { SITE } from '../consts';

const title = 'ご予約｜岐阜市長良の個室パーソナルストレッチ専門店 全力ストレッチ岐阜長良店';
const description = '全力ストレッチ岐阜長良店のご予約。ホットペッパー・LINE・お電話から、完全予約制。初回限定 60分3,300円。個室・マンツーマン、岐阜市長良・駐車場10台以上。';

const methods = [
  { no: '01', t: 'WEB予約（ホットペッパー）', d: '24時間受付。空き状況を見て、そのまま予約できます。', href: SITE.urls.reserve, cta: 'HPBで予約する', primary: true },
  { no: '02', t: 'LINEで予約・相談', d: `友だち追加（${SITE.urls.lineHandle}）から、メッセージで気軽にご相談・ご予約。`, href: SITE.urls.line, cta: 'LINEを開く', primary: false },
  { no: '03', t: 'お電話', d: `${SITE.hours}（${SITE.closed}）／ご不明点もお気軽に。`, href: `tel:${SITE.telLink}`, cta: `TEL ${SITE.tel}`, primary: false },
];

const notes = [
  '完全予約制です。動きやすい服装がおすすめです（着替えのご用意もあります）。',
  'お車の方は、ビル東側の共同駐車場（10台以上）をご利用ください。',
  'お支払いは現金のほか、クレジットカード・交通系電子マネー・QRコード決済（PayPay等）・iD／QUICPayがご利用いただけます。',
  '体調やお悩みは、カウンセリングで遠慮なくお聞かせください。',
  `キャンセル・変更のご連絡は、お早めにお願いします（${'{{キャンセルポリシー}}'}）。`,
];

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'ご予約', item: new URL('/reserve', Astro.site).href },
  ],
};
---
<Base title={title} description={description} path="/reserve" jsonld={[breadcrumb]}>
  <section class="subpage-hero section-grid mx-auto max-w-content border-b border-ink/20 px-5 pb-24 pt-16 sm:px-10 sm:pb-32 sm:pt-[120px]">
    <div class="mb-10 sm:mb-14"><Breadcrumbs items={[{ label: 'トップ', href: '/' }, { label: 'ご予約' }]} /></div>
    <p class="display-title mb-6">RESERVATION</p>
    <h1 class="mb-4 text-[26px] font-black sm:text-[36px]">ご予約について<span class="sr-only">｜岐阜市長良のパーソナルストレッチ 全力ストレッチ岐阜長良店</span></h1>
    <p class="mb-16 max-w-[820px] text-[15px] leading-[2.1] text-sub sm:mb-20 sm:text-[17px]">
      ご予約は、ホットペッパービューティー・LINE・お電話から承ります（完全予約制）。初めての方は初回限定価格でご体験いただけます。
    </p>

    <div class="grid gap-10 sm:gap-12 lg:grid-cols-3">
      {methods.map((m) => (
        <div class="rule-top flex flex-col pt-7">
          <p class="mb-4 font-script text-[12px] font-extrabold leading-none tracking-[0.18em] text-[#92745e]">{m.no}</p>
          <h2 class="mb-3 text-[19px] font-black">{m.t}</h2>
          <p class="mb-7 flex-1 text-[15px] leading-[2] text-sub">{m.d}</p>
          <a href={m.href} target={m.href.startsWith('tel:') ? undefined : '_blank'} rel="noopener" class={m.primary ? 'btn-amber-pill' : 'btn-ink-pill'}>{m.cta}</a>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-ink/15 bg-paper2 px-5 py-24 sm:px-10 sm:py-32">
    <div class="mx-auto grid max-w-content items-start gap-14 lg:grid-cols-2 lg:gap-[88px]">
      <div>
        <p class="en-label mb-8">Price</p>
        <h2 class="jp-title mb-10">料金</h2>
        <PriceRows />
      </div>
      <div>
        <p class="en-label mb-8">Before Your Visit</p>
        <h2 class="jp-title mb-10">ご来店前のご案内</h2>
        <ul class="rule-top">
          {notes.map((n) => (
            <li class="rule-row flex items-baseline gap-5 px-1 py-5 text-[15px] leading-[2] text-sub">
              <svg class="w-[22px] shrink-0 translate-y-0.5" viewBox="0 0 28 24" fill="none" aria-hidden="true"><path d="M4 13 L 11 20 L 25 4" stroke="#1A1A1A" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              {n}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <ReserveCTA />
</Base>
