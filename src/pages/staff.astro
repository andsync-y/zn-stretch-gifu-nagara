---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import { STAFF, LAST_UPDATED } from '../consts';

const title = 'スタッフ紹介｜岐阜市長良の完全個室パーソナルストレッチ専門店 全力ストレッチ岐阜長良店';
const description = '全力ストレッチ岐阜長良店のトレーナー紹介。全員女性の体感軸調整トレーナーが、完全個室・マンツーマンで施術します。岐阜市長良。';

const personSchemas = STAFF.map((s) => ({
  '@context': 'https://schema.org', '@type': 'Person',
  name: s.name,
  jobTitle: s.role,
  worksFor: { '@id': new URL('/#localbusiness', Astro.site).href },
  description: s.word,
}));

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'スタッフ紹介', item: new URL('/staff', Astro.site).href },
  ],
};
---
<Base title={title} description={description} path="/staff" jsonld={[...personSchemas, breadcrumb]}>
  <section class="subpage-hero section-grid mx-auto max-w-content border-b border-ink/20 px-5 pb-24 pt-16 sm:px-10 sm:pb-32 sm:pt-[120px]">
    <div class="mb-10 sm:mb-14"><Breadcrumbs items={[{ label: 'トップ', href: '/' }, { label: 'スタッフ紹介' }]} /></div>
    <h1 class="display-title mb-6">STAFF</h1>
    <p class="mb-4 text-[26px] font-black sm:text-[36px]">体のこと、任せてください。</p>
    <p class="mb-16 max-w-[820px] text-[15px] leading-[2.1] text-sub sm:mb-20 sm:text-[17px]">
      担当するのは、全員女性の体感軸調整トレーナー。完全個室でマンツーマン、最初から最後まで一人のトレーナーがあなたの体と向き合います。ご希望のトレーナーがいれば、ご予約時にご指名いただけます（指名料3,300円）。</p>

    <div class="grid grid-cols-2 gap-x-5 gap-y-12 sm:gap-x-7 lg:grid-cols-3 lg:gap-y-16">
      {STAFF.map((s, i) => (
        <figure class={i % 2 === 1 ? 'sm:mt-11' : ''}>
          <img src={s.photo} alt={`トレーナー ${s.name}（${s.kana}）`} width="800" height="1069" loading="lazy" decoding="async" class="mb-5 aspect-[3/4] w-full object-cover object-top grayscale transition duration-700 hover:grayscale-0" />
          <figcaption class="text-center">
            <p class="text-lg font-black tracking-[0.1em] sm:text-xl">{s.name}<span class="ml-3 text-sm font-medium text-muted">{s.kana}</span></p>
            <p class="mt-1 text-xs tracking-[0.08em] text-muted">{s.role}</p>
            <p class="mt-4 font-hand text-[15px] leading-[2] text-sub">{s.word}</p>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="mt-14 text-xs leading-[2] text-muted">
      ※経歴・保有資格は確認でき次第掲載します。<br />最終更新：{LAST_UPDATED}
    </p>
  </section>

  <ReserveCTA title="担当トレーナーが、あなたの一回に全力で向き合います。" />
</Base>
