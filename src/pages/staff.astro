---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import { SITE, STAFF, LAST_UPDATED } from '../consts';

const title = 'スタッフ紹介｜岐阜市長良のパーソナルストレッチ｜全力ストレッチ岐阜長良店';
const description = '全力ストレッチ岐阜長良店の体感軸調整トレーナー紹介。完全個室でマンツーマン対応、女性トレーナー在籍。岐阜市長良。';

// Person schema（経歴はプレースホルダ・創作しない）
const personSchemas = STAFF.map((s) => ({
  '@context': 'https://schema.org', '@type': 'Person',
  name: s.name,
  jobTitle: s.role,
  worksFor: { '@id': new URL('/#localbusiness', Astro.site).href },
  description: s.word,
}));

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'スタッフ紹介', item: new URL('/staff', Astro.site).href },
  ],
};
---
<Base title={title} description={description} path="/staff" jsonld={[...personSchemas, breadcrumb]}>
  <Breadcrumbs items={[{ label: 'ホーム', href: '/' }, { label: 'スタッフ紹介' }]} />
  <header class="container-x pt-8 pb-10">
    <p class="eyebrow">STAFF</p>
    <h1 class="mt-3 text-3xl font-black sm:text-4xl">スタッフ紹介</h1>
    <p class="prose-jp mt-5 max-w-2xl">
      当店のトレーナーは全員「体感軸調整トレーナー」。完全個室でマンツーマン、担当が最初から最後まで向き合います。
      <span class="hand">女性トレーナーも在籍</span>しています。ご希望があればご予約時にお知らせください。
    </p>
    <p class="mt-3 text-xs text-charcoal/60">※顔写真は準備中（実写に差し替え予定）。経歴・保有資格は確認でき次第掲載します（現在は未掲載）。</p>
  </header>

  <section class="container-x pb-10">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {STAFF.map((s) => (
        <figure class="rounded-2xl border border-line p-6">
          <img src="/images/placeholder-staff.svg" alt={`スタッフ ${s.name}（${s.kana}）の写真`} width="600" height="600" loading="lazy" decoding="async" class="aspect-square w-full rounded-xl border border-line bg-panel object-cover" />
          <figcaption class="mt-4">
            <p class="font-heading text-xl font-bold">{s.name}</p>
            <p class="text-sm text-charcoal">{s.kana}</p>
            <p class="mt-1 text-xs text-charcoal/70">{s.role}</p>
            <p class="hand mt-3 leading-relaxed text-charcoal">{s.word}</p>
            <p class="mt-3 text-xs text-charcoal/50">経歴：{`{{スタッフ_経歴_${s.name}}}`}（準備中）</p>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="mt-8 text-xs text-charcoal/60">最終更新：{LAST_UPDATED}</p>
  </section>

  <ReserveCTA title="担当トレーナーが、あなたの一回に向き合います" />
</Base>
