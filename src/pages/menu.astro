---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PriceRows from '../components/PriceRows.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import { SITE, LAST_UPDATED } from '../consts';

const title = 'メニュー・料金｜岐阜市長良の完全個室パーソナルストレッチ専門店 全力ストレッチ岐阜長良店';
const description = '全力ストレッチ岐阜長良店の料金。お試しコース60分・全身ケアコース90分・ヘッドスパ付き120分。初回限定最大75%OFF。完全個室・マンツーマン、岐阜市長良・駐車場10台以上。';

const points = [
  { t: '完全個室・マンツーマン', d: '他のお客様と顔を合わせないプライベート空間で、担当トレーナーが最初から最後まで対応します。' },
  { t: 'ザウルス式 体幹軸調整', d: '元格闘家考案の独自メソッド。もみほぐしではなく、軸をつくる筋肉を伸ばします。' },
  { t: '女性トレーナー在籍', d: 'もみほぐし×ストレッチで、その日の状態に合わせて丁寧に施術します。' },
  { t: '通いやすさ', d: '22時まで営業・駐車場10台以上。仕事帰りやゴルフ帰りにも。着替えのご用意もあります。' },
];

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'メニュー・料金', item: new URL('/menu', Astro.site).href },
  ],
};
---
<Base title={title} description={description} path="/menu" jsonld={[breadcrumb]}>
  <section class="mx-auto max-w-content px-5 pb-24 pt-16 sm:px-10 sm:pb-32 sm:pt-[120px]">
    <div class="mb-10 sm:mb-14"><Breadcrumbs items={[{ label: 'トップ', href: '/' }, { label: 'メニュー・料金' }]} /></div>
    <h1 class="display-title mb-6">PRICE</h1>
    <p class="mb-4 text-[26px] font-black sm:text-[36px]">まずは、初回3,300円から。</p>
    <p class="mb-14 max-w-[820px] text-[15px] leading-[2.1] text-sub sm:mb-16 sm:text-[17px]">
      メニューはパーソナルストレッチのみ。時間と内容で3つのコースからお選びいただけます。どのコースも完全個室・マンツーマンです。
    </p>

    <div class="max-w-[900px]"><PriceRows /></div>
    <a href={SITE.urls.reserve} target="_blank" rel="noopener" class="btn-ink-pill mt-10">初回価格で予約する</a>
  </section>

  <section class="border-t border-ink/15 bg-paper2 px-5 py-24 sm:px-10 sm:py-32">
    <div class="mx-auto max-w-content">
      <p class="en-label mb-8">Feature</p>
      <h2 class="jp-title mb-14">料金以外に、選ばれる理由。</h2>
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 sm:gap-12">
        {points.map((p, i) => (
          <div class="rule-top pt-7">
            <p class="mb-4 font-display text-[26px] italic leading-none text-faint">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mb-3 text-[19px] font-black">{p.t}</h3>
            <p class="text-[15px] leading-[2] text-sub">{p.d}</p>
          </div>
        ))}
      </div>
      <p class="mt-14 text-[13px] leading-[2] text-sub">
        ※お支払い方法などの詳細は、ご予約時またはご来店時にご案内します。<br />最終更新：{LAST_UPDATED}
      </p>
    </div>
  </section>

  <ReserveCTA />
</Base>
