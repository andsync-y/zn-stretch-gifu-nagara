---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import { SITE, PRICING, LAST_UPDATED } from '../consts';

const title = 'メニュー・料金｜岐阜市長良のパーソナルストレッチ｜全力ストレッチ岐阜長良店';
const description = '全力ストレッチ岐阜長良店の料金。パーソナルストレッチ60分・90分、初回限定75%OFF。完全個室・マンツーマン。岐阜市長良・駐車場あり。';

const plans = [
  { ...PRICING.min60, note: 'まずはお試しに。肩・腰など気になる部位を中心に。' },
  { ...PRICING.min90, note: 'じっくり全身を。しっかりゆるめたい方に。' },
];

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'メニュー・料金', item: new URL('/menu', Astro.site).href },
  ],
};
---
<Base title={title} description={description} path="/menu" jsonld={[breadcrumb]}>
  <Breadcrumbs items={[{ label: 'ホーム', href: '/' }, { label: 'メニュー・料金' }]} />
  <header class="container-x pt-8 pb-10">
    <p class="eyebrow">MENU & PRICE</p>
    <h1 class="mt-3 text-3xl font-black sm:text-4xl">メニュー・料金</h1>
    <p class="prose-jp mt-5 max-w-2xl">
      全力ストレッチ岐阜長良店は、完全個室・マンツーマンのパーソナルストレッチ専門店です。
      メニューは「パーソナルストレッチ」1本。時間で60分・90分をお選びいただけます。
      初めての方は<span class="marker">初回限定75%OFF</span>でお試しいただけます。
    </p>
  </header>

  <section class="container-x pb-6">
    <div class="grid gap-6 md:grid-cols-2">
      {plans.map((p) => (
        <div class="rounded-3xl border border-line p-8">
          <p class="font-heading text-xl font-bold">パーソナルストレッチ {p.label}</p>
          <p class="mt-2 text-sm text-charcoal">{p.note}</p>
          <div class="mt-6 flex flex-wrap items-baseline gap-3">
            <span class="text-charcoal/60 line-through">通常 {p.normal}</span>
          </div>
          <div class="mt-1 flex flex-wrap items-baseline gap-2">
            <span class="text-4xl font-black text-amber-700">{p.first}</span>
            <span class="text-sm font-bold text-amber-700">{p.discount}</span>
          </div>
          <a href={SITE.urls.reserve} target="_blank" rel="noopener" class="btn-amber mt-6 w-full">この内容で初回予約</a>
        </div>
      ))}
    </div>
    <div class="mt-6 rounded-2xl border border-line bg-offwhite p-6 text-sm text-charcoal">
      <ul class="space-y-2">
        <li>・表示はすべて税込です。</li>
        <li>・初回価格は、初めてご来店の方が対象です。</li>
        <li>・{PRICING.note}最新の料金は店頭・ご予約ページでご確認ください。</li>
        <li>・お支払い方法など詳細は、ご予約時またはご来店時にご案内します（{`{{支払い方法}}`}）。</li>
      </ul>
    </div>
  </section>

  <section class="container-x py-12">
    <p class="eyebrow">POINT</p>
    <h2 class="mt-2 text-2xl font-bold sm:text-3xl">料金以外に選ばれる理由</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { t: '完全個室', d: '人目を気にせず集中できる空間。' },
        { t: 'マンツーマン', d: '担当トレーナーが最初から最後まで対応。' },
        { t: '女性トレーナー在籍', d: 'ご希望や状況に配慮します。' },
        { t: '駐車場あり', d: 'ビル東側に共同駐車場10台以上。' },
      ].map((x) => (
        <div class="rounded-2xl border border-line p-6">
          <p class="hand text-lg">{x.t}</p>
          <p class="mt-2 text-sm text-charcoal">{x.d}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-xs text-charcoal/60">最終更新：{LAST_UPDATED}</p>
  </section>

  <ReserveCTA title="初回75%OFFで、まず体験" />
</Base>
