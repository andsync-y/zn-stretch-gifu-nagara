---
import Base from '../layouts/Base.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import PriceRows from '../components/PriceRows.astro';
import SymptomIcon from '../components/SymptomIcon.astro';
import { SITE, BRAND, STAFF, SYMPTOMS, PHOTOS, REVIEWS } from '../consts';

const title = '岐阜市長良の完全個室パーソナルストレッチ｜全力ストレッチ岐阜長良店';
const description = '岐阜市長良の完全個室・マンツーマンのパーソナルストレッチ専門店。元格闘家考案・独自の「体感軸調整法」で動ける身体へ。初回60分3,300円、駐車場10台以上、22時まで営業。';

const mapQuery = encodeURIComponent(SITE.addressFull);

// TikTokのユーザー名が確定したらここに設定（例: 'zngifunagara'）。空の間は準備中表示
const TIKTOK_HANDLE = '';

// CONCEPT 3つの特長（デザイン準拠・薬機法/景表法調整済み）
const concepts = [
  {
    no: '01',
    title: 'ZST協会認定『体感軸調整法』',
    body: '元格闘家考案の独自メソッド。骨盤角度と肩甲骨の可動域にアプローチし、姿勢やゴルフのアドレス・スイングの安定を目指します。',
  },
  {
    no: '02',
    title: '全席完全個室・マンツーマン',
    body: '施術はすべて完全個室のプライベート空間で、マンツーマンで行います。着替えもご用意しております。',
  },
  {
    no: '03',
    title: 'トレーナーは全員女性',
    body: '全員女性の体感軸調整トレーナーが、もみほぐしとストレッチを組み合わせ、その日の状態に合わせて丁寧に施術します。',
  },
];

// METHOD 3本柱（ジグザグ）
const methods = [
  { no: '01', en: 'Pelvis', title: '骨盤へのアプローチ', body: '体の土台となる骨盤まわりの筋肉をゆるめ、軸を意識しやすい状態へ整えていきます。', photo: PHOTOS.method1, alt: '骨盤まわりへのパーソナルストレッチ' },
  { no: '02', en: 'Posture', title: '猫背・巻き肩へのアプローチ', body: '縮こまりがちな胸や肩まわりの筋肉を伸ばし、胸を開きやすい状態を目指します。', photo: PHOTOS.method2, alt: '猫背・巻き肩へのパーソナルストレッチ', flip: true },
  { no: '03', en: 'Deep Muscle', title: '筋膜ほぐし＋深層筋ストレッチ', body: '表層をほぐしてから、自分では届きにくい深層の筋肉までじっくりストレッチします。', photo: PHOTOS.method3, alt: '深層筋へのパーソナルストレッチ' },
];

const marqueeWords = [
  '#完全個室',
  '#マンツーマン',
  '#完全女性トレーナー',
  '#全く新しいストレッチサロン',
  '#岐阜初出店',
  '#独自の体感軸調整法',
  '#深層筋にアプローチ',
  '#根本改善',
];
---
<Base title={title} description={description} path="/">
  <!-- HERO：連番フレーム（動画のコマ）をスクロールに同期してスクラブ再生する3Dスクロール演出 -->
  <section class="hero-scrub" data-hero>
    <div class="hero-scrub-stage">
      <picture>
        <source media="(max-width: 768px)" srcset="/frames/sp/frame_0001.jpg" />
        <img class="hero-scrub-fallback" data-hero-fallback src="/frames/frame_0001.jpg" width="1920" height="1080" alt="完全個室で行う体感軸パーソナルストレッチの施術シーン" fetchpriority="high" decoding="async" />
      </picture>
      <canvas data-hero-canvas aria-hidden="true"></canvas>

      <!-- キャッチコピー（動画には文字が入っていないため、HTMLテキストで表示・アニメーション） -->
      <div class="hero-copy">
        <h1>
          <span class="hero-line"><span class="hero-line-inner">もっと動ける</span></span>
          <span class="hero-line hero-line-second"><span class="hero-line-inner">軽い身体へ。</span></span>
          <span class="sr-only">｜全力ストレッチ岐阜長良店（岐阜市長良の完全個室パーソナルストレッチ専門店）</span>
        </h1>
        <p class="hero-copy-sub">岐阜市長良・完全個室のパーソナルストレッチ専門店</p>
      </div>

      <div class="hero-offer">
        <div class="hero-offer-heading">
          <p><span>FIRST</span><span>SESSION</span></p>
          <strong>初回限定</strong>
        </div>
        <div class="hero-offer-price">
          <p><span>集中ケアコース</span><b>60 min.</b></p>
          <p><del>¥13,200</del><strong>¥3,300</strong><small>税込</small></p>
        </div>
        <a href={SITE.urls.reserve} target="_blank" rel="noopener">WEB予約 <span aria-hidden="true">↗</span></a>
        <p class="hero-offer-note">※初回価格はおひとり様1回限り。価格は変更となる場合があります。</p>
      </div>

      <div class="hero-scroll-sign" aria-hidden="true"><span>SCROLL TO MOVE</span><i></i></div>
    </div>
  </section>

  <script>
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const canvas = hero?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const fallback = hero?.querySelector<HTMLElement>('[data-hero-fallback]');
    const offer = hero?.querySelector<HTMLElement>('.hero-offer');
    const ctx = canvas?.getContext('2d');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const OFFER_AT = 0.72; // オファーカードを出すスクロール進捗
    const SCRUB_END = 0.85; // ここまでで最終フレームに到達し、残りは静止
    // PCとSPは別動画（PC=横1920x1080/169枚・SP=縦720x1280/106枚）
    const cfg = window.innerWidth <= 768
      ? { dir: '/frames/sp', count: 106 }
      : { dir: '/frames', count: 169 };
    const FRAME_COUNT = cfg.count;
    const srcOf = (i: number) => `${cfg.dir}/frame_${String(i + 1).padStart(4, '0')}.jpg`;

    const images: (HTMLImageElement | null)[] = new Array(FRAME_COUNT).fill(null);
    let currentFrame = -1;
    let drawnFrame = -1;
    let ticking = false;

    // 表示中フレーム以下で読み込み済みの直近フレームを描く（読み込み中の飛びを防ぐ）
    const nearestLoaded = (i: number) => {
      for (let k = i; k >= 0; k--) if (images[k]?.complete) return k;
      return -1;
    };

    const draw = () => {
      if (!canvas || !ctx || !hero) return;
      const stage = canvas.parentElement as HTMLElement;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      const cw = stage.clientWidth;
      const ch = stage.clientHeight;
      if (canvas.width !== Math.round(cw * dpr) || canvas.height !== Math.round(ch * dpr)) {
        canvas.width = Math.round(cw * dpr);
        canvas.height = Math.round(ch * dpr);
      }
      const idx = nearestLoaded(Math.max(0, currentFrame));
      if (idx < 0) return;
      const img = images[idx]!;
      const iw = img.naturalWidth;
      const ih = img.naturalHeight;
      // PC=横動画/SP=縦動画で画面向きと一致するため、常にcoverで中央配置
      const scale = Math.max(canvas.width / iw, canvas.height / ih);
      const dw = iw * scale;
      const dh = ih * scale;
      ctx.fillStyle = '#f7f7f4';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, (canvas.width - dw) / 2, (canvas.height - dh) / 2, dw, dh);
      drawnFrame = idx;
      if (fallback && fallback.style.opacity !== '0') fallback.style.opacity = '0';
    };

    const load = (i: number, onload?: () => void) => {
      if (images[i]) return;
      const img = new Image();
      img.decoding = 'async';
      img.src = srcOf(i);
      img.onload = () => onload?.();
      images[i] = img;
    };

    const updateHero = () => {
      ticking = false;
      if (!hero) return;
      const rect = hero.getBoundingClientRect();
      const distance = Math.max(1, hero.offsetHeight - window.innerHeight);
      const progress = reduceMotion.matches ? 1 : Math.min(1, Math.max(0, -rect.top / distance));
      hero.style.setProperty('--hero-progress', progress.toFixed(4));
      hero.classList.toggle('is-offer-visible', progress >= OFFER_AT);
      offer?.toggleAttribute('inert', progress < OFFER_AT && !reduceMotion.matches);
      currentFrame = Math.min(FRAME_COUNT - 1, Math.floor((progress / SCRUB_END) * FRAME_COUNT));
      if (currentFrame !== drawnFrame) draw();
    };

    const requestHeroUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateHero);
    };

    if (hero && canvas && ctx) {
      if (reduceMotion.matches) {
        // 動きを減らす設定：スクラブせず1フレーム目を静止表示
        currentFrame = 0;
        load(0, draw);
        updateHero();
      } else {
        load(0, () => { draw(); });
        // 残りは同時6本ずつ順次プリロード
        let next = 1;
        const pump = () => {
          if (next >= FRAME_COUNT) return;
          const i = next++;
          load(i, () => {
            if (i <= currentFrame && drawnFrame < i) draw();
            pump();
          });
        };
        for (let c = 0; c < 6; c++) pump();
        updateHero();
        addEventListener('scroll', requestHeroUpdate, { passive: true });
        addEventListener('resize', () => { drawnFrame = -1; requestHeroUpdate(); }, { passive: true });
      }
    }
  </script>

  <!-- MARQUEE（画像・背景なしのキーワードのみ） -->
  <section class="home-marquee overflow-hidden py-10 sm:py-16" aria-hidden="true">
    <div class="flex w-max animate-marquee">
      {[0, 1].map(() => (
        <div class="flex items-baseline">
          {marqueeWords.map((word) => (
            <span class="whitespace-nowrap px-7 text-[22px] font-black tracking-[0.06em] sm:px-12 sm:text-[38px]">{word}</span>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- CONCEPT -->
  <section id="concept" class="home-concept section-grid relative border-b border-ink/20 px-5 py-24 sm:px-10 sm:py-36 xl:px-14">
    <span class="side-label">Concept — 01</span>
    <div class="mx-auto max-w-[1440px]">
      <div class="mb-12 flex items-end justify-between gap-8 sm:mb-20">
        <h2 class="display-title rise">CONCEPT</h2>
        <p class="editorial-kicker hidden sm:inline-flex">OUR PHILOSOPHY</p>
      </div>
      <div class="grid items-center gap-12 lg:grid-cols-[520px_1fr] lg:gap-[88px]">
        <div class="rise relative order-2 lg:order-1">
          <span class="absolute -left-3 -top-5 z-10 bg-ink px-3 py-1 font-script text-[9px] font-extrabold tracking-[0.18em] text-white">01 / BODY AXIS</span>
          <img src={PHOTOS.concept} alt="マンツーマンで行う体感軸調整ストレッチ" width="1060" height="1700" loading="lazy" decoding="async" class="h-[420px] w-full object-cover grayscale lg:h-[850px]" style="object-position:center 62%" />
        </div>
        <div class="rise order-1 lg:order-2">
          <p class="mb-7 text-[23px] font-black leading-[1.8] sm:text-[32px] lg:text-[40px] lg:leading-[1.7]">
            <span class="text-[30px] leading-[1.6] sm:text-[42px] lg:text-[54px] lg:leading-[1.5]">動ける身体を取り戻す。</span><br />
            大人のための<span class="frame-word">体感軸</span><br />パーソナルストレッチ。
          </p>
          <p class="mb-10 text-[15px] leading-[2.2] tracking-[0.03em] text-muted sm:mb-12 sm:text-[17px]">
            日々の疲労、姿勢の崩れからゴルフの飛距離まで。元格闘家考案の独自メソッドが、完全個室のプライベート空間であなたの身体の可動域を引き出します。
          </p>
          <div class="rule-top">
            {concepts.map((c) => (
              <div class="rule-row flex items-baseline gap-4 px-1 py-5 sm:gap-6">
                <span class="shrink-0 font-script text-[12px] font-extrabold leading-none tracking-[0.16em] text-[#92745e]">{c.no}</span>
                <div class="text-[15px] leading-[2] text-muted sm:text-[17px]">
                  <span class="mb-1.5 block text-[21px] font-black text-ink sm:mb-2 sm:text-[28px]">{c.title}</span>
                  {c.body}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- METHOD -->
  <section id="method" class="home-method relative border-b border-ink/20 bg-paper2 px-5 py-24 sm:px-10 sm:py-36 xl:px-14">
    <span class="side-label" style="top:40px">Method — 02</span>
    <div class="mx-auto max-w-[1440px]">
      <div class="rise">
        <p class="editorial-kicker mb-7">HOW WE MOVE</p>
        <h2 class="display-title mb-8">METHOD</h2>
        <p class="mb-16 max-w-[640px] text-[15px] leading-[2.1] tracking-[0.03em] text-muted sm:mb-[88px] sm:text-[17px]">
          元格闘家のオーナーが考案した独自の「体感軸調整法」。もみほぐしではなく、体の軸をつくる筋肉へのストレッチで深い部分からアプローチします。
        </p>
      </div>
      <div class="flex flex-col gap-16 sm:gap-24">
        {methods.map((m) => (
          <div class={`rise grid items-center gap-8 lg:gap-20 ${m.flip ? 'lg:grid-cols-[1fr_460px]' : 'lg:grid-cols-[460px_1fr]'}`}>
            <img
              src={m.photo} alt={m.alt} width="920" height="660" loading="lazy" decoding="async"
              class={`h-[270px] w-full object-cover grayscale transition duration-700 hover:grayscale-0 sm:h-[360px] ${m.flip ? 'lg:order-2' : ''}`}
              style="object-position:center 68%"
            />
            <div class={m.flip ? 'lg:order-1 lg:flex lg:flex-col lg:items-end lg:text-right' : ''}>
              <h3 class="mb-4 text-[22px] font-black sm:text-[31px]">
                <span class="mr-4 font-script text-[11px] font-extrabold tracking-[0.16em] text-[#92745e]">{m.no}</span>{m.title}
              </h3>
              <p class="max-w-[560px] text-[15px] leading-[2.1] text-muted sm:text-[17px]">{m.body}</p>
              <p class={`mt-6 flex items-center gap-3.5 text-[13px] font-medium tracking-[0.22em] sm:mt-7 ${m.flip ? 'lg:flex-row-reverse' : ''}`}>
                <span class="inline-block h-px w-[52px] bg-ink"></span>{m.en}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SYMPTOMS（黒） -->
  <section id="symptoms" class="home-symptoms relative bg-ink px-5 py-24 text-inkpaper sm:px-10 sm:py-36 xl:px-14">
    <span class="side-label" style="color:#777">Symptoms — 03</span>
    <div class="mx-auto max-w-[1440px]">
      <div class="rise">
        <p class="editorial-kicker mb-7 !text-[#c0aa98]">FIND YOUR CONDITION</p>
        <h2 class="display-title mb-8 !text-inkpaper">SYMPTOMS</h2>
        <p class="mb-14 text-[15px] leading-[2.1] tracking-[0.03em] text-inkmuted sm:mb-20 sm:text-[17px]">お悩みから探す。気になるお悩みに合わせて、アプローチの内容をご紹介します。</p>
      </div>
      <div class="rise grid border-t border-inkpaper/35 md:grid-cols-2">
        {SYMPTOMS.map((s, i) => (
          <a href={`/symptoms/${s.slug}`} class="group grid grid-cols-[72px_1fr_28px] items-center gap-4 border-b border-inkpaper/25 px-2 py-5 no-underline transition hover:bg-white/[0.04] sm:grid-cols-[92px_1fr_34px] sm:px-5 sm:py-7 md:odd:border-r">
            <span class="block h-[62px] w-[62px] brightness-0 invert opacity-80 transition duration-500 group-hover:scale-105 group-hover:opacity-100 sm:h-[78px] sm:w-[78px]"><SymptomIcon slug={s.slug} /></span>
            <span>
              <span class="mb-2 block font-script text-[8px] font-extrabold tracking-[0.18em] text-[#c0aa98]">{String(i + 1).padStart(2, '0')} / CONDITION</span>
              <span class="block text-[15px] font-black leading-[1.6] text-inkpaper sm:text-xl">{s.label}</span>
              {s.note && <span class="mt-1 hidden text-[11px] text-inkfaint sm:block">{s.note}</span>}
            </span>
            <span class="text-right text-xl font-normal text-inkpaper transition group-hover:text-[#c0aa98]" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>

      <!-- ブランド実績（ブランド主語） -->
      <div class="rise section-grid-dark mt-20 border border-inkpaper/30 p-8 text-center sm:mt-28 sm:p-14">
        <p class="en-label-dark mb-6" style="letter-spacing:0.3em;font-size:16px">Nationwide Brand</p>
        <p class="mb-7 flex justify-center">
          <img src="/images/logo.png" alt="全力ストレッチ PHYSICAL CONDITIONING SALON" width="1200" height="307" loading="lazy" decoding="async" class="h-auto w-[240px] invert sm:w-[340px]" />
        </p>
        <p class="mb-4 text-[24px] font-black text-inkpaper sm:text-[36px]">全国約70店舗のパーソナルストレッチブランド。</p>
        <p class="mb-7 text-[15px] leading-[2.1] text-inkmuted sm:text-base">全力ストレッチは、テレビや雑誌、YouTubeなど各種メディアでも紹介されているブランドです。</p>
        <ul class="flex flex-wrap justify-center gap-3">
          {['テレビ番組で紹介', '雑誌掲載', 'YouTube', '元格闘家オーナー考案「体感軸調整法」'].map((t) => (
            <li class="border border-inkpaper/35 px-5 py-2 text-xs tracking-[0.14em] text-inkmuted">{t}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- STAFF -->
  <section id="staff" class="home-staff section-grid relative border-b border-ink/20 px-5 py-24 sm:px-10 sm:py-36 xl:px-14">
    <span class="side-label">Staff — 04</span>
    <div class="mx-auto max-w-[1440px]">
      <div class="rise">
        <p class="editorial-kicker mb-7">PERSONAL TRAINERS</p>
        <h2 class="display-title mb-8">STAFF</h2>
        <p class="mb-14 text-[15px] leading-[2.1] tracking-[0.03em] text-muted sm:mb-20 sm:text-[17px]">担当は、全員女性の体感軸調整トレーナー。最初から最後まで、マンツーマンであなたの体と向き合います。</p>
      </div>
      <div class="rise grid grid-cols-2 gap-x-5 gap-y-10 sm:gap-x-7 sm:gap-y-14 lg:grid-cols-4">
        {STAFF.map((s, i) => (
          <div class={i % 2 === 1 ? 'lg:mt-11' : ''}>
            <div class="relative mb-4 overflow-hidden sm:mb-5">
              <span class="absolute left-3 top-3 z-10 bg-ink px-2 py-1 font-script text-[8px] font-extrabold tracking-[0.16em] text-white">{String(i + 1).padStart(2, '0')}</span>
              <img src={s.photo} alt={`トレーナー ${s.name}（${s.kana}）`} width="800" height="1069" loading="lazy" decoding="async" class="aspect-[3/4] w-full object-cover object-top grayscale transition duration-700 hover:grayscale-0" />
            </div>
            <p class="text-left text-base font-black tracking-[0.08em] sm:text-lg">{s.name}</p>
            <p class="mt-1 text-left text-[10px] font-bold tracking-[0.14em] text-muted sm:text-xs">{s.role}</p>
          </div>
        ))}
      </div>
      <div class="mt-12"><a href="/staff" class="text-[15px] font-bold underline-offset-4 hover:underline">スタッフ紹介をもっと見る →</a></div>
    </div>
  </section>

  <!-- VOICE（枠組み・実クチコミ投入まで準備中表示） -->
  <section class="home-voice bg-paper2 px-5 py-24 sm:px-10 sm:py-36 xl:px-14">
    <div class="mx-auto max-w-[1440px]">
      <div class="rise border-t-2 border-ink">
        <div class="px-1 py-14 sm:py-[72px]">
          <div class="mb-14 flex flex-col justify-between gap-7 sm:flex-row sm:items-end">
            <h2 class="display-title">VOICE</h2>
            <p class="editorial-kicker">GOOGLE REVIEWS</p>
          </div>
          <div class="grid gap-x-14 gap-y-12 md:grid-cols-3">
            {REVIEWS.slice(0, 6).map((r) => (
              <div>
                <div class="mb-3.5 flex items-baseline justify-between gap-3">
                  <span class="text-[15px] font-black tracking-[0.06em]">{r.name}</span>
                  <span class="text-sm tracking-[0.12em] text-[#92745e]" aria-label={`星${r.stars}つ`}>{'★'.repeat(r.stars)}{'☆'.repeat(5 - r.stars)}</span>
                </div>
                <p class="border-t border-ink/25 pt-4 text-[15px] leading-[2.1] text-muted sm:text-base">{r.text}</p>
              </div>
            ))}
          </div>
          <p class="mt-12 text-center text-[12px] text-muted">※Googleマップに投稿された実際のクチコミを、原文のまま掲載しています。効果には個人差があります。</p>
          <p class="mt-4 text-center"><a href="/voice" class="text-[15px] font-bold underline-offset-4 hover:underline">お客様の声をもっと見る →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- SNS（Instagram / TikTok 埋め込み・遅延読み込み） -->
  <section id="sns" class="home-sns border-b border-ink/20 px-5 py-24 sm:px-10 sm:py-36 xl:px-14">
    <div class="mx-auto max-w-[1440px]">
      <p class="editorial-kicker mb-7">FOLLOW THE MOVEMENT</p>
      <h2 class="display-title mb-16">SOCIAL</h2>
      <div class="grid items-start gap-10 md:grid-cols-2 lg:gap-16">
        <!-- Instagram -->
        <div>
          <p class="mb-4 flex items-center gap-3 text-[15px] font-black tracking-[0.08em]">
            Instagram <a href={SITE.urls.instagram} target="_blank" rel="noopener" class="text-[13px] font-medium text-muted underline underline-offset-4">{SITE.urls.instagramHandle}</a>
          </p>
          <blockquote
            class="instagram-media !m-0 w-full border border-ink/15 bg-white"
            data-instgrm-permalink={SITE.urls.instagram}
            data-instgrm-version="14"
            style="min-height:480px"
          >
            <a href={SITE.urls.instagram} target="_blank" rel="noopener" class="block p-8 text-center text-sm text-sub">Instagramで見る（{SITE.urls.instagramHandle}）</a>
          </blockquote>
        </div>
        <!-- TikTok -->
        <div>
          <p class="mb-4 text-[15px] font-black tracking-[0.08em]">TikTok</p>
          {TIKTOK_HANDLE ? (
            <blockquote
              class="tiktok-embed !m-0 w-full"
              cite={`https://www.tiktok.com/@${TIKTOK_HANDLE}`}
              data-unique-id={TIKTOK_HANDLE}
              data-embed-type="creator"
              style="min-height:480px"
            >
              <section><a target="_blank" rel="noopener" href={`https://www.tiktok.com/@${TIKTOK_HANDLE}`}>@{TIKTOK_HANDLE}</a></section>
            </blockquote>
          ) : (
            <div class="flex min-h-[480px] items-center justify-center border border-dashed border-[#D9D9D5] p-8 text-center text-sm leading-[2] text-sub">
              TikTokは準備中です。<br />アカウント公開後にこちらに表示されます。
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
  <script>
    // SNS埋め込みスクリプトはセクションが見えてから読み込む（表示速度優先）
    const sns = document.getElementById('sns');
    if (sns) {
      const load = () => {
        for (const src of ['https://www.instagram.com/embed.js', 'https://www.tiktok.com/embed.js']) {
          const s = document.createElement('script');
          s.src = src;
          s.async = true;
          document.body.appendChild(s);
        }
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            load();
            io.disconnect();
          }
        }, { rootMargin: '600px' });
        io.observe(sns);
      } else {
        load();
      }
    }
  </script>

  <!-- PRICE + ACCESS -->
  <section id="price" class="home-info section-grid relative bg-paper2 px-5 py-24 sm:px-10 sm:py-36 xl:px-14">
    <div class="mx-auto grid max-w-[1440px] items-start gap-16 lg:grid-cols-2 lg:gap-[104px]">
      <div class="rise">
        <h2 class="display-title mb-10 sm:mb-14">PRICE</h2>
        <PriceRows showBadge={false} />
        <a href={SITE.urls.coupon} target="_blank" rel="noopener" class="btn-ink-pill mt-8">初回価格で予約する</a>
      </div>
      <div class="rise" id="access">
        <h2 class="display-title mb-10 sm:mb-14">ACCESS</h2>
        <div class="rule-top text-base leading-[2]">
          <div class="rule-row grid grid-cols-[92px_1fr] gap-4 px-1 py-5 sm:grid-cols-[120px_1fr]"><span class="font-bold">住所</span><span class="text-muted">{SITE.addressFull}<br />（{SITE.landmark}）</span></div>
          <div class="rule-row grid grid-cols-[92px_1fr] gap-4 px-1 py-5 sm:grid-cols-[120px_1fr]"><span class="font-bold">駐車場</span><span class="text-muted">{SITE.parking}</span></div>
          <div class="rule-row grid grid-cols-[92px_1fr] gap-4 px-1 py-5 sm:grid-cols-[120px_1fr]"><span class="font-bold">営業時間</span><span class="text-muted">{SITE.hours}（{SITE.closed}）</span></div>
          <div class="rule-row grid grid-cols-[92px_1fr] gap-4 px-1 py-5 sm:grid-cols-[120px_1fr]"><span class="font-bold">電話</span><a href={`tel:${SITE.telLink}`} class="text-muted underline">{SITE.tel}</a></div>
        </div>
        <iframe
          src={SITE.mapEmbed}
          title="全力ストレッチ岐阜長良店の周辺地図"
          width="1200" height="460" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen
          class="mt-7 h-[230px] w-full border-0 bg-panel"
        ></iframe>
        <a href="/access" class="mt-5 inline-block text-[15px] font-bold underline-offset-4 hover:underline">アクセスの詳細 →</a>
      </div>
    </div>
  </section>

  <ReserveCTA large={true} sub="気になる肩や腰、そのままにせず一度ご相談ください。" />
</Base>
