---
import Base from '../layouts/Base.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import PriceRows from '../components/PriceRows.astro';
import CircleBadge from '../components/CircleBadge.astro';
import { SITE, BRAND, STAFF, SYMPTOMS, PHOTOS, REVIEWS } from '../consts';

const title = '岐阜市長良の完全個室パーソナルストレッチ｜全力ストレッチ岐阜長良店';
const description = '岐阜市長良の完全個室・マンツーマンのパーソナルストレッチ専門店。元格闘家考案・独自の「体感軸調整法」で動ける身体へ。初回60分3,300円、駐車場10台以上、22時まで営業。';

const mapQuery = encodeURIComponent(SITE.addressFull);

// TikTokのユーザー名が確定したらここに設定（例: 'zngifunagara'）。空の間は準備中表示
const TIKTOK_HANDLE = '';

// CONCEPT 3つの特長（デザイン準拠・薬機法/景表法調整済み）
const concepts = [
  {
    no: '01',
    title: 'ZST協会認定『体感軸調整法』',
    body: '元格闘家考案の独自メソッド。骨盤角度と肩甲骨の可動域にアプローチし、姿勢やゴルフのアドレス・スイングの安定を目指します。',
  },
  {
    no: '02',
    title: '全席完全個室・マンツーマン',
    body: '他のお客様と一切顔を合わせないプライベート空間。着替えもご用意しております。',
  },
  {
    no: '03',
    title: 'トレーナーは全員女性',
    body: '全員女性の体感軸調整トレーナーが、もみほぐしとストレッチを組み合わせ、その日の状態に合わせて丁寧に施術します。',
  },
];

// METHOD 3本柱（ジグザグ）
const methods = [
  { no: '01', en: 'Pelvis', title: '骨盤へのアプローチ', body: '体の土台となる骨盤まわりの筋肉をゆるめ、軸を意識しやすい状態へ整えていきます。', photo: PHOTOS.method1, alt: '骨盤まわりへのパーソナルストレッチ' },
  { no: '02', en: 'Posture', title: '猫背・巻き肩へのアプローチ', body: '縮こまりがちな胸や肩まわりの筋肉を伸ばし、胸を開きやすい状態を目指します。', photo: PHOTOS.method2, alt: '猫背・巻き肩へのパーソナルストレッチ', flip: true },
  { no: '03', en: 'Deep Muscle', title: '筋膜ほぐし＋深層筋ストレッチ', body: '表層をほぐしてから、自分では届きにくい深層の筋肉までじっくりストレッチします。', photo: PHOTOS.method3, alt: '深層筋へのパーソナルストレッチ' },
];

const marqueeItems = [
  { photo: PHOTOS.marquee1, word: '完全個室' },
  { photo: PHOTOS.marquee2, word: 'マンツーマン' },
  { photo: PHOTOS.marquee3, word: '完全女性トレーナー' },
];
---
<Base title={title} description={description} path="/">
  <!-- HERO（SP=写真にキャッチをオーバーレイ／PC=大きなキャッチ＋大きな写真） -->
  <section class="relative overflow-hidden px-5 pb-20 pt-3 sm:px-10 sm:pt-12 xl:px-14">
    <div class="relative mx-auto grid max-w-[1440px] items-start gap-6 lg:grid-cols-[1fr_540px] lg:gap-16 xl:grid-cols-[1fr_620px]">
      <div class="order-2 lg:order-1 lg:pt-2">
        <!-- SPではキャッチを写真の上に重ねる（absoluteの基準は外側のgridコンテナ） -->
        <h1 class="absolute left-1 top-[22%] z-10 text-[30px] font-black leading-[1.7] tracking-[0.03em] lg:static lg:mb-7 lg:text-[40px] lg:leading-[1.65] lg:tracking-[0.02em] xl:text-[46px]">
          <span class="inline-block">平日はタフに、</span><br class="lg:hidden" /><span class="inline-block">週末はアクティブに。</span><br /><span class="inline-block">本気の大人のための</span><br class="lg:hidden" /><span class="frame-word bg-paper/70 lg:bg-transparent">身体改革</span>。
          <span class="sr-only">｜全力ストレッチ岐阜長良店（岐阜市長良の完全個室パーソナルストレッチ専門店）</span>
        </h1>

        <p class="mb-8 hidden text-[15px] leading-[2.1] tracking-[0.04em] text-muted lg:mb-12 lg:block lg:text-base">
          岐阜市長良の完全個室・マンツーマン、パーソナルストレッチ専門店。<br />Private &amp; personal stretch studio for your working body.
        </p>

        <p class="mb-3 inline-block border-2 border-ink px-3 py-1 text-[12px] font-black tracking-[0.14em] lg:mb-5 lg:px-4 lg:py-1.5 lg:text-[13px]">初回限定</p>
        <div class="mb-8 flex max-w-[520px] flex-col gap-1.5 lg:mb-11 lg:max-w-[600px] lg:gap-3">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 lg:gap-x-5">
            <span class="w-[8em] shrink-0 whitespace-nowrap text-[13px] font-bold tracking-[0.06em] lg:text-[17px]">集中ケアコース</span>
            <span class="text-[13px] font-bold lg:text-[17px]">60分</span>
            <span class="text-[13px] text-muted line-through lg:text-[16px]">13,200円</span>
            <span class="ml-auto font-display text-[38px] font-extrabold leading-none lg:text-[58px]">¥3,300</span>
          </div>
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 lg:gap-x-5">
            <span class="w-[8em] shrink-0 whitespace-nowrap text-[13px] font-bold tracking-[0.06em] lg:text-[17px]">全身ケアコース</span>
            <span class="text-[13px] font-bold lg:text-[17px]">90分</span>
            <span class="text-[13px] text-muted line-through lg:text-[16px]">19,800円</span>
            <span class="ml-auto font-display text-[38px] font-extrabold leading-none lg:text-[58px]">¥4,900</span>
          </div>
        </div>

        <a href={SITE.urls.reserve} target="_blank" rel="noopener" class="btn-ink block w-full text-center sm:inline-block sm:w-auto sm:tracking-[0.18em] lg:px-20 lg:py-6 lg:text-[17px]">WEB予約はこちら</a>
        <p class="mt-3 text-[11px] text-muted lg:mt-4 lg:text-xs">※税込。初回価格はおひとり様1回限りです。価格は変更となる場合があります。</p>
      </div>

      <!-- 写真（SP=全幅・キャッチの下地／PC=大きく右側）5枚クロスフェード -->
      <div class="relative order-1 h-[420px] w-full lg:order-2 lg:h-[700px] xl:h-[740px]">
        <img src={PHOTOS.hero} alt="完全個室で行うパーソナルストレッチの施術シーン" width="1280" height="1720" fetchpriority="high" decoding="async" class="h-full w-full object-cover" style="object-position:center 30%" />
        {[PHOTOS.hero, PHOTOS.concept, PHOTOS.method2, PHOTOS.method1, PHOTOS.method3].map((src, i) => (
          <img
            src={src} alt="" width="1280" height="1720" loading={i === 0 ? undefined : 'lazy'} decoding="async" aria-hidden="true"
            class="hero-slide absolute inset-0 h-full w-full object-cover"
            style={`object-position:center 30%;animation-delay:${i * 5}s`}
          />
        ))}
        <!-- SPのみ：オーバーレイ文字の可読性を上げる淡いグラデーション -->
        <div class="absolute inset-0 bg-gradient-to-t from-paper/70 via-paper/25 to-transparent lg:hidden" aria-hidden="true"></div>
        <CircleBadge class="absolute -bottom-12 right-[-6px] h-[120px] w-[120px] lg:right-auto lg:-left-20 lg:bottom-[-44px] lg:h-[210px] lg:w-[210px]" />
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <section class="overflow-hidden border-y border-ink bg-paper" aria-hidden="true">
    <div class="flex w-max animate-marquee">
      {[0, 1].map(() => (
        <div class="flex">
          {marqueeItems.map((m) => (
            <>
              <img src={m.photo} alt="" width="680" height="440" loading="lazy" decoding="async" class="h-[130px] w-[200px] object-cover sm:h-[220px] sm:w-[340px]" style="object-position:center 68%" />
              <span class="flex h-[130px] w-[180px] items-center justify-center border-x border-ink text-[15px] font-black tracking-[0.2em] sm:h-[220px] sm:w-[340px] sm:text-[22px]">{m.word}</span>
            </>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- CONCEPT -->
  <section id="concept" class="relative px-5 py-24 sm:px-10 sm:py-32 xl:px-14">
    <span class="side-label">Concept — 01</span>
    <div class="mx-auto max-w-[1440px]">
      <h2 class="display-title rise mb-12 sm:mb-16">CONCEPT</h2>
      <div class="grid items-center gap-12 lg:grid-cols-[520px_1fr] lg:gap-[88px]">
        <div class="rise relative order-2 lg:order-1">
          <img src={PHOTOS.concept} alt="マンツーマンで行う体感軸調整ストレッチ" width="1060" height="1700" loading="lazy" decoding="async" class="h-[380px] w-full object-cover lg:h-[850px]" style="object-position:center 62%" />
        </div>
        <div class="rise order-1 lg:order-2">
          <p class="mb-7 text-[23px] font-black leading-[1.8] sm:text-[32px] lg:text-[40px] lg:leading-[1.7]">
            <span class="text-[30px] leading-[1.6] sm:text-[42px] lg:text-[54px] lg:leading-[1.5]">動ける身体を取り戻す。</span><br />
            大人のための<span class="frame-word">体感軸</span><br />パーソナルストレッチ。
          </p>
          <p class="mb-10 text-[15px] leading-[2.2] tracking-[0.03em] text-muted sm:mb-12 sm:text-[17px]">
            日々の疲労、姿勢の崩れからゴルフの飛距離まで。元格闘家考案の独自メソッドが、完全個室のプライベート空間であなたの身体の可動域を引き出します。
          </p>
          <div class="rule-top">
            {concepts.map((c) => (
              <div class="rule-row flex items-baseline gap-4 px-1 py-5 sm:gap-6">
                <span class="shrink-0 font-display text-[36px] italic leading-none text-faint sm:text-[44px]">{c.no}</span>
                <div class="text-[15px] leading-[2] text-muted sm:text-[17px]">
                  <span class="mb-1.5 block text-[21px] font-black text-ink sm:mb-2 sm:text-[28px]">{c.title}</span>
                  {c.body}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- METHOD -->
  <section id="method" class="relative px-5 pb-24 sm:px-10 sm:pb-32 xl:px-14">
    <span class="side-label" style="top:40px">Method — 02</span>
    <div class="mx-auto max-w-[1440px]">
      <div class="rise">
        <h2 class="display-title mb-6">METHOD</h2>
        <p class="mb-16 max-w-[640px] text-[15px] leading-[2.1] tracking-[0.03em] text-muted sm:mb-[88px] sm:text-[17px]">
          元格闘家のオーナーが考案した独自の「体感軸調整法」。もみほぐしではなく、体の軸をつくる筋肉へのストレッチで深い部分からアプローチします。
        </p>
      </div>
      <div class="flex flex-col gap-16 sm:gap-24">
        {methods.map((m) => (
          <div class={`rise grid items-center gap-8 lg:gap-20 ${m.flip ? 'lg:grid-cols-[1fr_460px]' : 'lg:grid-cols-[460px_1fr]'}`}>
            <img
              src={m.photo} alt={m.alt} width="920" height="660" loading="lazy" decoding="async"
              class={`h-[240px] w-full object-cover sm:h-[330px] ${m.flip ? 'shadow-hard-l lg:order-2' : 'shadow-hard'}`}
              style="object-position:center 68%"
            />
            <div class={m.flip ? 'lg:order-1 lg:flex lg:flex-col lg:items-end lg:text-right' : ''}>
              <h3 class="mb-4 text-[22px] font-black sm:text-[31px]">
                <span class="mr-4 font-display text-[20px] font-semibold italic text-faint sm:text-[26px]">{m.no}</span>{m.title}
              </h3>
              <p class="max-w-[560px] text-[15px] leading-[2.1] text-muted sm:text-[17px]">{m.body}</p>
              <p class={`mt-6 flex items-center gap-3.5 text-[13px] font-medium tracking-[0.22em] sm:mt-7 ${m.flip ? 'lg:flex-row-reverse' : ''}`}>
                <span class="inline-block h-px w-[52px] bg-ink"></span>{m.en}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SYMPTOMS（黒） -->
  <section id="symptoms" class="relative bg-ink px-5 py-24 text-inkpaper sm:px-10 sm:py-32 xl:px-14">
    <span class="side-label" style="color:#777">Symptoms — 03</span>
    <div class="mx-auto max-w-[1440px]">
      <div class="rise">
        <h2 class="display-title mb-6 !text-inkpaper" style="mix-blend-mode:normal">SYMPTOMS</h2>
        <p class="mb-14 text-[15px] leading-[2.1] tracking-[0.03em] text-inkmuted sm:mb-20 sm:text-[17px]">お悩みから探す。気になるお悩みに合わせて、アプローチの内容をご紹介します。</p>
      </div>
      <div class="rise grid grid-cols-2 gap-x-6 md:gap-x-[72px]">
        {SYMPTOMS.map((s, i) => (
          <a href={`/symptoms/${s.slug}`} class="group flex items-baseline justify-between gap-3 border-b border-inkpaper/25 px-1 py-5 no-underline sm:gap-5 sm:py-[26px]">
            <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1 sm:gap-x-5">
              <span class="font-display text-sm italic text-[#777]">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-[15px] font-bold leading-[1.6] text-inkpaper sm:text-xl">{s.label}</span>
              {s.note && <span class="hidden text-[13px] text-inkfaint md:inline">{s.note}</span>}
            </span>
            <span class="shrink-0 font-bold text-inkpaper transition group-hover:text-amber" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <!-- ブランド実績（ブランド主語） -->
      <div class="rise mt-20 border border-inkpaper/30 p-8 text-center sm:mt-28 sm:p-14">
        <p class="en-label-dark mb-6" style="letter-spacing:0.3em;font-size:16px">Nationwide Brand</p>
        <p class="mb-7 flex justify-center">
          <img src="/images/logo.png" alt="全力ストレッチ PHYSICAL CONDITIONING SALON" width="1200" height="307" loading="lazy" decoding="async" class="h-auto w-[240px] invert sm:w-[340px]" />
        </p>
        <p class="mb-4 text-[24px] font-black text-inkpaper sm:text-[36px]">全国約70店舗のパーソナルストレッチブランド。</p>
        <p class="mb-7 text-[15px] leading-[2.1] text-inkmuted sm:text-base">全力ストレッチは、テレビや雑誌、YouTubeなど各種メディアでも紹介されているブランドです。</p>
        <ul class="flex flex-wrap justify-center gap-3">
          {['テレビ番組で紹介', '雑誌掲載', 'YouTube', '元格闘家オーナー考案「体感軸調整法」'].map((t) => (
            <li class="border border-inkpaper/35 px-5 py-2 text-xs tracking-[0.14em] text-inkmuted">{t}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- STAFF -->
  <section id="staff" class="relative px-5 py-24 sm:px-10 sm:py-32 xl:px-14">
    <span class="side-label">Staff — 04</span>
    <div class="mx-auto max-w-[1440px]">
      <div class="rise">
        <h2 class="display-title mb-6">STAFF</h2>
        <p class="mb-14 text-[15px] leading-[2.1] tracking-[0.03em] text-muted sm:mb-20 sm:text-[17px]">担当は、全員女性の体感軸調整トレーナー。最初から最後まで、マンツーマンであなたの体と向き合います。</p>
      </div>
      <div class="rise grid grid-cols-2 gap-x-5 gap-y-10 sm:gap-x-7 sm:gap-y-14 lg:grid-cols-4">
        {STAFF.map((s, i) => (
          <div class={i % 2 === 1 ? 'lg:mt-11' : ''}>
            <img src={s.photo} alt={`トレーナー ${s.name}（${s.kana}）`} width="800" height="1069" loading="lazy" decoding="async" class="mb-4 aspect-[3/4] w-full object-cover object-top shadow-hard-sm sm:mb-5" />
            <p class="text-center text-base font-black tracking-[0.1em] sm:text-lg">{s.name}</p>
            <p class="mt-1 text-center text-xs font-medium tracking-[0.1em] text-muted sm:text-sm">{s.role}</p>
          </div>
        ))}
      </div>
      <div class="mt-12"><a href="/staff" class="text-[15px] font-bold underline-offset-4 hover:underline">スタッフ紹介をもっと見る →</a></div>
    </div>
  </section>

  <!-- VOICE（枠組み・実クチコミ投入まで準備中表示） -->
  <section class="px-5 pb-24 sm:px-10 sm:pb-32 xl:px-14">
    <div class="mx-auto max-w-[1440px]">
      <div class="rise border border-ink p-2">
        <div class="border border-ink px-6 py-14 sm:px-16 sm:py-[72px]">
          <h2 class="display-title mb-6 text-center">VOICE</h2>
          <p class="mb-12 text-center text-sm tracking-[0.08em] text-muted">Google マップのクチコミより</p>
          <div class="grid gap-x-14 gap-y-12 md:grid-cols-3">
            {REVIEWS.slice(0, 6).map((r) => (
              <div>
                <div class="mb-3.5 flex items-baseline justify-between gap-3">
                  <span class="text-[15px] font-black tracking-[0.06em]">{r.name}</span>
                  <span class="text-sm tracking-[0.12em] text-amber" aria-label={`星${r.stars}つ`}>{'★'.repeat(r.stars)}{'☆'.repeat(5 - r.stars)}</span>
                </div>
                <p class="border-t border-ink/25 pt-4 text-[15px] leading-[2.1] text-muted sm:text-base">{r.text}</p>
              </div>
            ))}
          </div>
          <p class="mt-12 text-center text-[12px] text-muted">※Googleマップに投稿された実際のクチコミを、原文のまま掲載しています。効果には個人差があります。</p>
          <p class="mt-4 text-center"><a href="/voice" class="text-[15px] font-bold underline-offset-4 hover:underline">お客様の声をもっと見る →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- SNS（Instagram / TikTok 埋め込み・遅延読み込み） -->
  <section id="sns" class="px-5 pb-24 sm:px-10 sm:pb-32 xl:px-14">
    <div class="mx-auto max-w-[1440px]">
      <h2 class="display-title mb-12">SNS</h2>
      <div class="grid items-start gap-10 md:grid-cols-2 lg:gap-16">
        <!-- Instagram -->
        <div>
          <p class="mb-4 flex items-center gap-3 text-[15px] font-black tracking-[0.08em]">
            Instagram <a href={SITE.urls.instagram} target="_blank" rel="noopener" class="text-[13px] font-medium text-muted underline underline-offset-4">{SITE.urls.instagramHandle}</a>
          </p>
          <blockquote
            class="instagram-media !m-0 w-full border border-ink/15 bg-white"
            data-instgrm-permalink={SITE.urls.instagram}
            data-instgrm-version="14"
            style="min-height:480px"
          >
            <a href={SITE.urls.instagram} target="_blank" rel="noopener" class="block p-8 text-center text-sm text-sub">Instagramで見る（{SITE.urls.instagramHandle}）</a>
          </blockquote>
        </div>
        <!-- TikTok -->
        <div>
          <p class="mb-4 text-[15px] font-black tracking-[0.08em]">TikTok</p>
          {TIKTOK_HANDLE ? (
            <blockquote
              class="tiktok-embed !m-0 w-full"
              cite={`https://www.tiktok.com/@${TIKTOK_HANDLE}`}
              data-unique-id={TIKTOK_HANDLE}
              data-embed-type="creator"
              style="min-height:480px"
            >
              <section><a target="_blank" rel="noopener" href={`https://www.tiktok.com/@${TIKTOK_HANDLE}`}>@{TIKTOK_HANDLE}</a></section>
            </blockquote>
          ) : (
            <div class="flex min-h-[480px] items-center justify-center border border-dashed border-[#D9D9D5] p-8 text-center text-sm leading-[2] text-sub">
              TikTokは準備中です。<br />アカウント公開後にこちらに表示されます。
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
  <script>
    // SNS埋め込みスクリプトはセクションが見えてから読み込む（表示速度優先）
    const sns = document.getElementById('sns');
    if (sns) {
      const load = () => {
        for (const src of ['https://www.instagram.com/embed.js', 'https://www.tiktok.com/embed.js']) {
          const s = document.createElement('script');
          s.src = src;
          s.async = true;
          document.body.appendChild(s);
        }
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            load();
            io.disconnect();
          }
        }, { rootMargin: '600px' });
        io.observe(sns);
      } else {
        load();
      }
    }
  </script>

  <!-- PRICE + ACCESS -->
  <section id="price" class="relative px-5 pb-24 sm:px-10 sm:pb-32 xl:px-14">
    <div class="mx-auto grid max-w-[1440px] items-start gap-16 lg:grid-cols-2 lg:gap-[104px]">
      <div class="rise">
        <h2 class="display-title mb-10 sm:mb-14">PRICE</h2>
        <PriceRows />
        <a href={SITE.urls.coupon} target="_blank" rel="noopener" class="btn-ink-pill mt-8">初回価格で予約する</a>
      </div>
      <div class="rise" id="access">
        <h2 class="display-title mb-10 sm:mb-14">ACCESS</h2>
        <div class="rule-top text-base leading-[2]">
          <div class="rule-row grid grid-cols-[92px_1fr] gap-4 px-1 py-5 sm:grid-cols-[120px_1fr]"><span class="font-bold">住所</span><span class="text-muted">{SITE.addressFull}<br />（{SITE.landmark}）</span></div>
          <div class="rule-row grid grid-cols-[92px_1fr] gap-4 px-1 py-5 sm:grid-cols-[120px_1fr]"><span class="font-bold">駐車場</span><span class="text-muted">{SITE.parking}</span></div>
          <div class="rule-row grid grid-cols-[92px_1fr] gap-4 px-1 py-5 sm:grid-cols-[120px_1fr]"><span class="font-bold">営業時間</span><span class="text-muted">{SITE.hours}（{SITE.closed}）</span></div>
          <div class="rule-row grid grid-cols-[92px_1fr] gap-4 px-1 py-5 sm:grid-cols-[120px_1fr]"><span class="font-bold">電話</span><a href={`tel:${SITE.telLink}`} class="text-muted underline">{SITE.tel}</a></div>
        </div>
        <iframe
          src={SITE.mapEmbed}
          title="全力ストレッチ岐阜長良店の周辺地図"
          width="1200" height="460" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen
          class="mt-7 h-[230px] w-full border-0 bg-panel"
        ></iframe>
        <a href="/access" class="mt-5 inline-block text-[15px] font-bold underline-offset-4 hover:underline">アクセスの詳細 →</a>
      </div>
    </div>
  </section>

  <ReserveCTA large={true} sub="気になる肩や腰、そのままにせず一度ご相談ください。" />
</Base>
