---
import Base from '../layouts/Base.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import PriceRows from '../components/PriceRows.astro';
import InteractiveSymptoms from '../components/InteractiveSymptoms.astro';
import DataSection from '../components/DataSection.astro';
import FAQ from '../components/FAQ.astro';
import { SITE, BRAND, STAFF, PHOTOS, REVIEWS } from '../consts';

const title = '岐阜市長良の個室パーソナルストレッチ｜全力ストレッチ岐阜長良店';
const description = '岐阜市長良の個室・マンツーマンのパーソナルストレッチ専門店。元格闘家考案・独自の「体感軸調整法」で動ける身体へ。初回60分3,300円、駐車場10台以上、22時まで営業。';

const mapQuery = encodeURIComponent(SITE.addressFull);

// TikTokのユーザー名が確定したらここに設定（例: 'zngifunagara'）。空の間は準備中表示
const TIKTOK_HANDLE = '';

// CONCEPT 3つの特長（デザイン準拠・薬機法/景表法調整済み）
const concepts = [
  {
    no: '01',
    title: 'ZST協会認定『体感軸調整法』',
    body: '元格闘家考案の独自メソッド。骨盤角度と肩甲骨の可動域にアプローチし、姿勢やゴルフのアドレス・スイングの安定を目指します。',
  },
  {
    no: '02',
    title: '全席個室・マンツーマン',
    body: '施術はすべて個室のプライベート空間で、マンツーマンで行います。着替えもご用意しております。',
  },
  {
    no: '03',
    title: 'トレーナーは全員女性',
    body: '全員女性の体感軸調整トレーナーが、もみほぐしとストレッチを組み合わせ、その日の状態に合わせて丁寧に施術します。',
  },
];

// METHOD 3本柱（ジグザグ）
const methods = [
  { no: '01', en: 'Body Axis', title: 'ZST協会認定「体感軸調整法」', body: '元格闘家考案の独自の可動域調整法で、骨盤や肩甲骨など深層筋へアプローチ。認定プロが身体を整え、慢性的な不調の根本ケアをサポートします。', photo: PHOTOS.method1, alt: '体感軸調整法によるパーソナルストレッチ' },
  { no: '02', en: 'Release', title: '揉みほぐし×ストレッチ', body: '全身もみほぐしとストレッチ整体を融合。手技では届かないインナーマッスルを伸ばし、癒着を剥がします。女性による極上の癒やしと技術を同時に提供します。', photo: PHOTOS.method2, alt: 'もみほぐしとストレッチを融合した施術', flip: true },
  { no: '03', en: 'Effect', title: '圧倒的な「即効性」と<br class="md:hidden" />「具体的効果」', body: 'デスクワークの蓄積疲労をリセット。独自の可動域調整で肩こり解消や仕事の集中力向上、ゴルフ飛距離UPまでも叶えます。施術直後から実感できる変化が、ビジネスと趣味の両方でパフォーマンスを劇的に進化させます。', photo: PHOTOS.method3, alt: '施術直後から実感できる変化' },
];

// TOPのよくある質問（FAQPage構造化データと一致させる）
const faqs = [
  { q: '予約は必要ですか？', a: '完全予約制です。ホットペッパービューティー・LINE・お電話からご予約いただけます。当日予約も空きがあれば可能です。' },
  { q: '服装はどうすればいいですか？', a: '動きやすい服装でお越しください。上下の着替えを無料でご用意していますので、お仕事帰りでもそのままご来店いただけます。' },
  { q: '駐車場はありますか？', a: 'ビル東側に共同駐車場が10台以上ございます。岐阜市外からもお車で通いやすい立地です。' },
  { q: '男性でも利用できますか？', a: 'はい、男性のお客様も多くご利用いただいています。トレーナーは全員女性で、施術はすべて個室・マンツーマンで行います。' },
  { q: '施術は痛くないですか？', a: '「痛気持ちいい」と感じる強さを目安に、その日の体の状態に合わせて調整します。強さのご希望は施術中いつでもお伝えください。' },
  { q: '初回はどのコースを選べばいいですか？', a: '全身をしっかりケアできる全身ケアコース（90分）が一番人気です。まずは気になる部分を集中的にほぐしたい方には集中ケアコース（60分）、頭の疲れもすっきりさせたい方には全身ケア＋ヘッドスパ（120分）もおすすめしています。' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};


const marqueeWords = [
  '#個室',
  '#マンツーマン',
  '#完全女性トレーナー',
  '#全く新しいストレッチサロン',
  '#岐阜初出店',
  '#独自の体感軸調整法',
  '#深層筋にアプローチ',
  '#根本ケア',
];
---
<Base title={title} description={description} path="/" jsonld={[faqSchema]}>
  <!-- ローディング：MVフレームの先読みが済むまで画面を覆い、未読込フレームの乱れた表示を見せない（JS無効・reduced-motionでは非表示） -->
  <div class="hero-loader" data-hero-loader aria-hidden="true">
    <div class="hero-loader-inner">
      <img src="/images/logo.png" alt="" width="1200" height="307" loading="eager" decoding="async" />
      <p>PHYSICAL CONDITIONING SALON — GIFU NAGARA</p>
    </div>
    <b class="hero-loader-count" data-loader-count>0</b>
    <span class="hero-loader-bar" aria-hidden="true"></span>
  </div>
  <noscript><style>{`.hero-loader { display: none; }`}</style></noscript>

  <!-- HERO：連番フレーム（動画のコマ）をスクロールに同期してスクラブ再生。コンセプトはMV左側にパララックスで流れ込む -->
  <section id="concept" class="hero-scrub" data-hero>
    <div class="hero-scrub-stage">
      <picture>
        <source media="(max-width: 768px)" srcset="/frames/sp/frame_0001.webp" type="image/webp" />
        <img class="hero-scrub-fallback" data-hero-fallback src="/frames/frame_0001.webp" width="1920" height="1080" alt="個室で行う体感軸パーソナルストレッチの施術シーン" fetchpriority="high" decoding="async" />
      </picture>
      <canvas data-hero-canvas aria-hidden="true"></canvas>

      <!-- テキストオーバーレイ群：ヘッダー下でクリップ（MV=canvasは全面のまま、コンセプトのロールがヘッダーに被らない） -->
      <div class="hero-overlays">
      <!-- キャッチコピー（動画には文字が入っていないため、HTMLテキストで表示・アニメーション） -->
      <div class="hero-copy">
        <h1>
          <span class="hero-line"><span class="hero-line-inner">もっと動ける</span></span>
          <span class="hero-line hero-line-second"><span class="hero-line-inner">軽い身体へ。</span></span>
          <span class="sr-only">｜全力ストレッチ岐阜長良店（岐阜市長良の個室パーソナルストレッチ専門店）</span>
        </h1>
        <p class="hero-copy-sub">岐阜市長良・個室の<br class="lg:hidden" />パーソナルストレッチ専門店</p>
      </div>

      <!-- コンセプト：スクロールに応じてMV左側に情報がパララックスで流れ込む（--hero-progressで駆動） -->
      <div class="hero-concept">
        <div class="hero-concept-head">
          <p class="hero-concept-kicker">Concept — Our Philosophy</p>
          <h2 class="hero-concept-lead">話題のパーソナル<br />ストレッチサロンが<br />岐阜初出店。</h2>
          <p class="hero-concept-sub">個室・マンツーマンで、担当は全員女性トレーナー。元格闘家考案の独自メソッド「体感軸調整法」が深層筋にアプローチし、動ける身体へ導きます。</p>
        </div>
        <ul class="hero-concept-points">
          {concepts.map((c) => (
            <li style={`--i:${Number(c.no)}`}>
              <b>{c.no}</b>
              <span><strong>{c.title}</strong><i>{c.body}</i></span>
            </li>
          ))}
        </ul>
      </div>

      <div class="hero-offer">
        <div class="hero-offer-heading">
          <p><span>FIRST</span><span>SESSION</span></p>
          <strong>初回限定</strong>
        </div>
        <div class="hero-offer-price">
          <p><span>集中ケアコース</span><b>60 min.</b></p>
          <p><del>¥13,200</del><strong>¥3,300</strong><small>税込</small></p>
        </div>
        <div class="hero-offer-price">
          <p><span>全身ケアコース</span><b>90 min.</b></p>
          <p><del>¥19,800</del><strong>¥4,900</strong><small>税込</small></p>
        </div>
        <div class="hero-offer-price is-long">
          <p><span>全身ケア<br class="lg:hidden" />＋ヘッドスパ</span><b>120 min.</b></p>
          <p><del>¥26,400</del><strong>¥13,200</strong><small>税込</small></p>
        </div>
        <a href={SITE.urls.reserve} target="_blank" rel="noopener">WEB予約 <span aria-hidden="true">↗</span></a>
        <p class="hero-offer-note">※初回価格はおひとり様1回限り。価格は変更となる場合があります。</p>
      </div>

      <div class="hero-scroll-sign" aria-hidden="true"><span>SCROLL TO MOVE</span><i></i></div>
      </div>
    </div>
  </section>

  <script>
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const canvas = hero?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const fallback = hero?.querySelector<HTMLElement>('[data-hero-fallback]');
    const offer = hero?.querySelector<HTMLElement>('.hero-offer');
    const ctx = canvas?.getContext('2d');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const narrow = window.matchMedia('(max-width: 1023px)'); // SP/タブレット。PCはオファーカードを固定表示のまま常時操作可能にする

    const OFFER_AT = 0.03; // オファーカードを出すスクロール進捗（少しでもスクロールしたら表示）
    // 動画はピン留め区間全体（展開＋シート被せ＝METHODの終わりまで）に均等配分し、
    // ヒーロー解放（METHOD終端）とほぼ同時に最終フレームへ到達する
    // PCとSPは別動画（PC=横1920x1080/169枚・SP=縦720x1280/106枚）
    const cfg = window.innerWidth <= 768
      ? { dir: '/frames/sp', count: 106 }
      : { dir: '/frames', count: 169 };
    const FRAME_COUNT = cfg.count;
    const srcOf = (i: number) => `${cfg.dir}/frame_${String(i + 1).padStart(4, '0')}.webp`;

    const images: (HTMLImageElement | null)[] = new Array(FRAME_COUNT).fill(null);
    let currentFrame = -1;
    let drawnFrame = -1;
    let ticking = false;

    // スクラブの平滑化：スクロール由来の目標フレームへ毎フレーム少しずつ追従させ、
    // 1コマ単位の即時切替による「ガタつき」を滑らかな再生に変える
    let targetFrame = 0;
    let smoothFrame = 0;
    let scrubPlaying = false;
    const playTowardTarget = () => {
      // 追従係数は控えめ（0.14）：フリック後も映像がふわっと追いつき、自然な再生感になる
      smoothFrame += (targetFrame - smoothFrame) * 0.14;
      if (Math.abs(targetFrame - smoothFrame) < 0.4) smoothFrame = targetFrame;
      const f = Math.round(smoothFrame);
      if (f !== currentFrame) {
        currentFrame = f;
        draw();
      }
      if (smoothFrame !== targetFrame) requestAnimationFrame(playTowardTarget);
      else scrubPlaying = false;
    };
    const requestScrub = () => {
      if (scrubPlaying) return;
      scrubPlaying = true;
      requestAnimationFrame(playTowardTarget);
    };

    // 表示中フレーム以下で読み込み済みの直近フレームを描く（読み込み中の飛びを防ぐ）
    const nearestLoaded = (i: number) => {
      for (let k = i; k >= 0; k--) if (images[k]?.complete) return k;
      return -1;
    };

    const draw = () => {
      if (!canvas || !ctx || !hero) return;
      const stage = canvas.parentElement as HTMLElement;
      // canvasの解像度上限を1.5に抑えて1フレームの再描画コストを削減（元動画は横1920/縦720px幅のため画質劣化はほぼ無い）。PC/SP共通で軽くする
      const dpr = Math.min(1.5, window.devicePixelRatio || 1);
      const cw = stage.clientWidth;
      const ch = stage.clientHeight;
      if (canvas.width !== Math.round(cw * dpr) || canvas.height !== Math.round(ch * dpr)) {
        canvas.width = Math.round(cw * dpr);
        canvas.height = Math.round(ch * dpr);
      }
      const idx = nearestLoaded(Math.max(0, currentFrame));
      if (idx < 0) return;
      const img = images[idx]!;
      const iw = img.naturalWidth;
      const ih = img.naturalHeight;
      // PC=横動画/SP=縦動画で画面向きと一致するため、常にcoverで中央配置
      const scale = Math.max(canvas.width / iw, canvas.height / ih);
      const dw = iw * scale;
      const dh = ih * scale;
      // coverスケールで必ず全面を覆うため、毎フレームのfillRect（背景塗り）は省略して描画を軽量化
      ctx.drawImage(img, (canvas.width - dw) / 2, (canvas.height - dh) / 2, dw, dh);
      drawnFrame = idx;
      if (fallback && fallback.style.opacity !== '0') fallback.style.opacity = '0';
    };

    // ローディング表示：初期表示に必要なフレームが揃うまでMVを覆う（未読込フレームの乱れた露出を防ぐ）
    const loader = document.querySelector<HTMLElement>('[data-hero-loader]');
    const loaderCount = loader?.querySelector<HTMLElement>('[data-loader-count]');
    const LOADER_TARGET = Math.min(FRAME_COUNT, 24); // 初期表示に必要とみなす枚数
    const LOADER_MIN_MS = 1150; // ブランド表示の最低時間（キャッシュ時の一瞬のチラつき防止）
    const LOADER_MAX_MS = 3800; // 回線が遅くてもこれ以上は待たせない
    const loaderStart = performance.now();
    let loadedCount = 0;

    const finishLoader = () => {
      if (!loader || loader.dataset.done) return;
      loader.dataset.done = '1';
      if (loaderCount) loaderCount.textContent = '100';
      loader.style.setProperty('--load-progress', '1');
      const wait = Math.max(0, LOADER_MIN_MS - (performance.now() - loaderStart));
      setTimeout(() => {
        loader.classList.add('is-done');
        loader.addEventListener('transitionend', () => loader.classList.add('is-hidden'), { once: true });
        setTimeout(() => loader.classList.add('is-hidden'), 1100); // transitionendが飛んだ場合の保険
      }, wait);
    };

    const updateLoaderUI = () => {
      if (!loader || !loaderCount || loader.dataset.done) return;
      const pct = Math.min(100, Math.round((loadedCount / LOADER_TARGET) * 100));
      loaderCount.textContent = String(pct);
      loader.style.setProperty('--load-progress', String(pct / 100));
      if (loadedCount >= LOADER_TARGET) finishLoader();
    };

    const load = (i: number, onload?: () => void) => {
      const existing = images[i];
      if (existing) {
        // 既に読込済み・読込中でも、プリロードのチェーン（pump）が止まらないようコールバックは必ず呼ぶ
        if (existing.complete) onload?.();
        else existing.addEventListener('load', () => onload?.(), { once: true });
        return;
      }
      const img = new Image();
      img.decoding = 'async';
      img.src = srcOf(i);
      img.onload = () => {
        loadedCount++;
        updateLoaderUI();
        onload?.();
      };
      images[i] = img;
    };

    // ヒーローの絶対位置・スクロール距離はレイアウトが変わった時だけ計測する。
    // 毎フレームのgetBoundingClientRect（強制リフロー）を避けることで、スクロール追従が軽くなる。
    let heroTop = 0;
    let heroDist = 1;
    const measureHero = () => {
      if (!hero) return;
      heroTop = hero.getBoundingClientRect().top + window.scrollY;
      heroDist = Math.max(1, hero.offsetHeight - window.innerHeight);
    };

    // ヒーローのピン留めを「METHODの終わり」まで延長する動的サイズ調整。
    // 展開（スクラブ＋コンセプト）区間A → シート（マルキー→DATA→半透明METHOD）が上を通る区間B、
    // METHOD下端が画面上端に達した瞬間にヒーローが解放される（B = 1画面 + シート上端からMETHOD下端まで）。
    const sheet = document.querySelector<HTMLElement>('.hero-follow');
    const methodSec = document.getElementById('method');
    let unfoldLen = 0; // A：ヒーロー展開に使うスクロール量
    let lastVh = 1;
    const sizeHero = () => {
      if (!hero) return;
      if (!reduceMotion.matches && sheet && methodSec) {
        const vh = window.innerHeight;
        lastVh = Math.max(1, vh);
        const methodBottom = methodSec.offsetTop + methodSec.offsetHeight; // シート上端からMETHOD下端まで
        const coverLen = vh + methodBottom;
        unfoldLen = Math.round(vh * (narrow.matches ? 3.2 : 4)); // 展開はゆっくり（従来より延長）
        hero.style.height = `${vh + unfoldLen + coverLen}px`;
        sheet.style.marginTop = `-${coverLen}px`;
      }
      measureHero();
    };

    const updateHero = () => {
      ticking = false;
      if (!hero) return;
      // scrollYのみで進捗を算出（レイアウト読み取りをしないのでスクロールが軽い）
      const scrolled = window.scrollY - heroTop;
      const denom = unfoldLen || heroDist;
      const progress = reduceMotion.matches ? 1 : Math.min(1, Math.max(0, scrolled / denom));
      // シートがヒーローを覆う進捗（0=未到達、1=全面被覆）。コンセプト・オファー等のフェードアウトに使う
      const cover = reduceMotion.matches || !unfoldLen ? 0 : Math.min(1, Math.max(0, (scrolled - unfoldLen) / lastVh));
      hero.style.setProperty('--hero-progress', progress.toFixed(4));
      hero.style.setProperty('--hero-cover', cover.toFixed(4));
      hero.classList.toggle('is-offer-visible', progress >= OFFER_AT);
      // SP/タブレットのみ：オファーカードが退場したら（進捗0.3超）タップを透過し、下部固定CTA・コンセプトを妨げない。PCではカードは固定のまま操作可能
      const offerLeaving = narrow.matches && progress > 0.3;
      hero.classList.toggle('is-offer-leaving', offerLeaving && !reduceMotion.matches);
      offer?.toggleAttribute('inert', (progress < OFFER_AT || (offerLeaving && progress > 0.4)) && !reduceMotion.matches);
      // 動画フレームはピン留め全区間（heroDist＝展開A＋被せB）に均等配分。
      // METHOD透過背景の背後でも進み続け、ヒーロー解放（METHOD終端）で最終フレームに到達する
      const pTotal = reduceMotion.matches ? 1 : Math.min(1, Math.max(0, scrolled / heroDist));
      targetFrame = Math.min(FRAME_COUNT - 1, Math.floor(pTotal * FRAME_COUNT));
      if (targetFrame !== currentFrame) requestScrub();
    };

    const requestHeroUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateHero);
    };

    if (hero && canvas && ctx) {
      sizeHero();
      // フォント・画像読込でレイアウトが動く可能性があるため、loadでも再計測（METHOD下端位置が変わりうる）
      addEventListener('load', () => { sizeHero(); requestHeroUpdate(); }, { passive: true });
      if (reduceMotion.matches) {
        // 動きを減らす設定：ローダーは出さず、スクラブせず1フレーム目を静止表示
        loader?.classList.add('is-hidden');
        currentFrame = 0;
        load(0, draw);
        updateHero();
      } else {
        setTimeout(finishLoader, LOADER_MAX_MS);
        load(0, () => { draw(); });
        // 残りは同時8本ずつ順次プリロード（フレーム未読込による飛び＝カクつきを減らす）
        let next = 1;
        const pump = () => {
          if (next >= FRAME_COUNT) return;
          const i = next++;
          load(i, () => {
            if (i <= currentFrame && drawnFrame < i) draw();
            pump();
          });
        };
        for (let c = 0; c < 8; c++) pump();
        updateHero();
        // リロードでスクロール位置が途中に復元された場合、現在位置周辺のフレームを優先読込して
        // 「先頭フレームだけが表示される不一致（乱れた見た目）」を短時間で解消する
        if (currentFrame > 8) {
          for (let k = 0; k < 8; k++) {
            const idx = Math.min(FRAME_COUNT - 1, currentFrame + k);
            load(idx, () => { if (idx <= currentFrame && drawnFrame < idx) draw(); });
          }
        }
        addEventListener('scroll', requestHeroUpdate, { passive: true });
        // モバイルのURLバー伸縮は「高さだけのresize」を連発する。そのたびにヒーロー寸法を
        // 再計算するとスクロール中にレイアウトが跳ねてガタつくため、幅が変わった時だけ再計算する
        let lastW = window.innerWidth;
        addEventListener('resize', () => {
          if (window.innerWidth !== lastW) {
            lastW = window.innerWidth;
            sizeHero();
            drawnFrame = -1;
          }
          requestHeroUpdate();
        }, { passive: true });
      }
    }
  </script>

  <!-- 以降のコンテンツを角丸シートで包み、固定されたヒーローの上へ少し持ち上がって被さる（パララックスで上を通る）演出 -->
