  <script>
    // SNS埋め込みスクリプトはセクションが見えてから読み込む（表示速度優先）
    const sns = document.getElementById('sns');
    if (sns) {
      const load = () => {
        for (const src of ['https://www.instagram.com/embed.js', 'https://www.tiktok.com/embed.js']) {
          const s = document.createElement('script');
          s.src = src;
          s.async = true;
          document.body.appendChild(s);
        }
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            load();
            io.disconnect();
          }
        }, { rootMargin: '600px' });
        io.observe(sns);
      } else {
        load();
      }
    }
  </script>

