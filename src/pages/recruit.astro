---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, STAFF, PHOTOS } from '../consts';

const title = '採用情報｜土日勤務歓迎・体感軸調整トレーナー募集｜全力ストレッチ岐阜長良店';
const description = '全力ストレッチ岐阜長良店では、一緒に働く体感軸調整トレーナー（ストレッチセラピスト）を募集しています。土日に勤務できる方を特に歓迎。未経験から約40時間の研修で基礎を学べます。個室・マンツーマンのパーソナルストレッチ専門店（岐阜市長良）。ご応募はIndeedから。';

// 募集要項（2026-07-13 オーナー確認済みの実データ）
const requirements = [
  { t: '職種', d: '体感軸調整トレーナー（ストレッチセラピスト）' },
  { t: '雇用形態', d: 'アルバイト' },
  { t: '給与', d: '時給1,600円〜3,000円\n※試用期間は時給1,400円（1〜3ヶ月）\nインセンティブあり（指名1名につき3,000円全額還元／回数券販売枚数に応じたバックあり）' },
  { t: '勤務時間', d: '09:30〜22:30内のシフト制' },
  { t: '休日', d: '週休二日制' },
  { t: '勤務地', d: `${SITE.addressFull}（${SITE.landmark}・車通勤可/駐車場あり）` },
  { t: '応募資格', d: '18歳以上' },
  { t: '研修', d: '約40時間（6日間）の講習で、ストレッチ施術や接客マナーなど、基礎から学びます。独自の「体感軸調整ストレッチ」の技術はもちろん、お客様に選ばれる接客・コミュニケーションまで丁寧に指導します。\n決して楽な研修ではありませんが、認定試験をクリアした暁にはディプロマを発行。「体のプロ」として自信を持ってデビューできます！' },
];

const attractions = [
  { no: '01', t: '独自メソッドが身につく', d: '元格闘家考案・ZST協会認定「体感軸調整法」の研修を受けて、もみほぐしとは違う「伸ばす」技術を基礎から習得できます。' },
  { no: '02', t: '個室でお客様と1対1', d: '流れ作業ではなく、カウンセリングから施術まで一人のお客様とじっくり向き合えます。「来てよかった」の声が直接届く仕事です。' },
  { no: '03', t: 'オープンしたての店舗', d: '2026年6月オープン。お店の空気も、働き方も、これから一緒につくっていくフェーズです。全国約70店舗のブランドの仕組みも活かせます。' },
  { no: '04', t: '頑張りが、そのまま返ってくる', d: '指名1名につき3,000円を全額還元。回数券の販売枚数に応じたバックもあります。お客様に選ばれるほど、収入に反映される仕組みです。' },
];

// 土日歓迎の理由。予約が土日に集中し、トレーナーが足りていない曜日であるため（docs/capacity-analysis.md）
const weekendPoints = [
  { t: '土日はご予約が集中する曜日です', d: '平日に比べて、土日はご予約が多く入ります。お客様と向き合う時間をしっかり確保できる曜日です。' },
  { t: '指名・回数券のインセンティブにつながりやすい', d: '施術の機会が多いぶん、指名や回数券のご購入につながる機会も増えます。インセンティブは指名1名につき3,000円の全額還元と、回数券の販売枚数に応じたバックです。' },
  { t: '勤務日数・曜日はご相談ください', d: '土日を含めて勤務できる方を歓迎しています。週に何日・どの曜日に入れるかは、面接でご希望を伺います。' },
];
// トレーナーの仕事の流れ（お客様1人あたり）。/lp の「初回体験の流れ」と同じ工程をトレーナー側から書いたもの。
// 1日の時間割は確定した情報が無いため載せない
const workflow = [
  { no: '01', t: 'カウンセリング', d: '個室で、気になる部位や生活習慣を伺います。お客様の体の状態を知るための大切な時間です。' },
  { no: '02', t: '施術（体感軸調整法）', d: '研修で身につけた技術で、マンツーマンで体を伸ばしていきます。主力は90分のコースです。' },
  { no: '03', t: 'アフターチェック', d: '施術前との違いをお客様と一緒に確かめ、ご自宅でできるセルフケアをお伝えします。' },
];
// よくある質問。回答は募集要項（2026-07-13 オーナー確認済み）にある事実だけで書く
const faqs = [
  { q: '未経験でも応募できますか？', a: '応募資格は18歳以上です。約40時間（6日間）の研修で、ストレッチ施術や接客マナーを基礎から学べます。認定試験に合格するとディプロマが発行されます。' },
  { q: '土日だけの勤務はできますか？', a: '土日を含めて勤務できる方を特に歓迎しています。勤務日数や曜日のご希望は、面接でご相談ください。' },
  { q: '研修期間中の給与はどうなりますか？', a: '試用期間（1〜3ヶ月）は時給1,400円です。試用期間後は時給1,600円〜3,000円で、インセンティブもあります。' },
  { q: '車で通勤できますか？', a: '車通勤が可能で、駐車場もあります。' },
  { q: '応募の前に見学できますか？', a: '見学のご相談も受け付けています。Indeedの求人ページからお気軽にお問い合わせください。' },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: '採用情報', item: new URL('/recruit', Astro.site).href },
  ],
};

// JobPosting構造化データ（募集条件確定済み・2026-07-13）
const jobPosting = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: '体感軸調整トレーナー（ストレッチセラピスト）',
  description:
    '<p>個室・マンツーマンのパーソナルストレッチ専門店「全力ストレッチ岐阜長良店」で、一緒に働く体感軸調整トレーナー（ストレッチセラピスト）を募集しています。土日に勤務できる方を特に歓迎しています。約40時間（6日間）の研修で、ストレッチ施術や接客マナーを基礎から学べます。認定試験合格後はディプロマを発行します。ご応募はIndeedの求人ページから受け付けています。</p>',
  datePosted: '2026-07-13',
  employmentType: 'PART_TIME',
  hiringOrganization: { '@type': 'Organization', name: SITE.operator, sameAs: Astro.site!.href },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.streetAddress,
      addressLocality: SITE.addressLocality,
      addressRegion: SITE.addressRegion,
      postalCode: SITE.postalCode,
      addressCountry: 'JP',
    },
  },
  baseSalary: {
    '@type': 'MonetaryAmount',
    currency: 'JPY',
    value: { '@type': 'QuantitativeValue', minValue: 1600, maxValue: 3000, unitText: 'HOUR' },
  },
};
---
<Base title={title} description={description} path="/recruit" jsonld={[breadcrumb, jobPosting, faqJsonLd]} hideMobileCta>
  <section class="subpage-hero section-grid mx-auto max-w-content border-b border-ink/20 px-5 pb-24 pt-16 sm:px-10 sm:pb-32 sm:pt-[120px]">
    <div class="mb-10 sm:mb-14"><Breadcrumbs items={[{ label: 'トップ', href: '/' }, { label: '採用情報' }]} /></div>
    <p class="display-title mb-6">RECRUIT</p>
    <h1 class="mb-4 text-[26px] font-black leading-[1.6] sm:text-[36px]">あなたの手で、<br class="sm:hidden" />「動ける身体」をつくる仕事。<span class="sr-only">｜岐阜市長良のストレッチトレーナー採用情報</span></h1>
    <p class="mb-14 max-w-[820px] text-[15px] leading-[2.1] text-sub sm:mb-16 sm:text-[17px]">
      全力ストレッチ岐阜長良店では、一緒に働く体感軸調整トレーナー（ストレッチセラピスト）を募集しています。
      個室・マンツーマンで、お客様一人ひとりの体とじっくり向き合える環境です。
      <strong class="font-black text-ink">土日に勤務できる方を、特に歓迎しています。</strong>
    </p>
    <div class="flex flex-col gap-4 sm:flex-row" data-cta-source="recruit-hero">
      <a href={SITE.urls.recruit} target="_blank" rel="noopener" class="btn-amber-pill sm:px-14">Indeedで応募する</a>
      <a href="#requirements" class="btn-ink-pill sm:px-10">募集要項を見る</a>
    </div>
  </section>

  <!-- 土日歓迎 -->
  <section class="px-5 py-24 sm:px-10 sm:py-32">
    <div class="mx-auto max-w-content">
      <p class="en-label mb-8">Weekend</p>
      <h2 class="jp-title mb-6">土日に勤務できる方を、<br class="sm:hidden" />特に歓迎しています。</h2>
      <p class="mb-14 max-w-[820px] text-[15px] leading-[2.1] text-sub sm:text-[16px]">
        土日はご予約が多い曜日です。土日に入っていただける方がいると、より多くのお客様をお迎えできるようになります。
      </p>
      <div class="grid gap-10 sm:grid-cols-3 sm:gap-12">
        {weekendPoints.map((w) => (
          <div class="rule-top pt-7">
            <h3 class="mb-3 text-[18px] font-black leading-[1.6]">{w.t}</h3>
            <p class="text-[15px] leading-[2] text-sub">{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 働く魅力 -->
  <section class="border-t border-ink/15 bg-paper2 px-5 py-24 sm:px-10 sm:py-32">
    <div class="mx-auto max-w-content">
      <p class="en-label mb-8">Why Join Us</p>
      <h2 class="jp-title mb-14">この店で働く、4つの理由。</h2>
      <div class="grid gap-10 sm:grid-cols-2 sm:gap-12 lg:grid-cols-4">
        {attractions.map((a) => (
          <div class="rule-top pt-7">
            <p class="mb-4 font-script text-[12px] font-extrabold leading-none tracking-[0.18em] text-[#92745e]">{a.no}</p>
            <h3 class="mb-3 text-[19px] font-black">{a.t}</h3>
            <p class="text-[15px] leading-[2] text-sub">{a.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 職場の様子 -->
  <section class="px-5 py-24 sm:px-10 sm:py-32">
    <div class="mx-auto max-w-content">
      <p class="en-label mb-8">Workplace</p>
      <h2 class="jp-title mb-14">一緒に働く仲間</h2>
      <div class="grid grid-cols-3 gap-4 sm:grid-cols-4 sm:gap-6 lg:grid-cols-7">
        {STAFF.map((s) => (
          <div>
            <img src={s.photo} alt={`トレーナー ${s.name}`} width="800" height="1069" loading="lazy" decoding="async" class="aspect-[3/4] w-full object-cover object-top" />
            <p class="mt-2 text-center text-[12px] font-black tracking-[0.08em]">{s.name}</p>
          </div>
        ))}
      </div>
      <img src={PHOTOS.method3} alt="個室での施術の様子" width="1400" height="930" loading="lazy" decoding="async" class="mt-10 h-[240px] w-full object-cover sm:h-[380px]" />
    </div>
  </section>

  <!-- 仕事の流れ -->
  <section class="border-t border-ink/15 px-5 py-24 sm:px-10 sm:py-32">
    <div class="mx-auto max-w-content">
      <p class="en-label mb-8">Work Flow</p>
      <h2 class="jp-title mb-4">お客様1人あたりの、仕事の流れ</h2>
      <p class="mb-14 text-[14px] leading-[2] text-sub">カウンセリングから施術、施術後のご説明まで、同じトレーナーが最後まで担当します。</p>
      <div class="grid gap-10 sm:grid-cols-3 sm:gap-12">
        {workflow.map((w) => (
          <div class="rule-top pt-7">
            <p class="mb-4 font-script text-[12px] font-extrabold leading-none tracking-[0.18em] text-[#92745e]">{w.no}</p>
            <h3 class="mb-3 text-[19px] font-black">{w.t}</h3>
            <p class="text-[15px] leading-[2] text-sub">{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 募集要項 -->
  <section id="requirements" class="border-t border-ink/15 bg-paper2 px-5 py-24 sm:px-10 sm:py-32">
    <div class="mx-auto max-w-content">
      <p class="en-label mb-8">Requirements</p>
      <h2 class="jp-title mb-4">募集要項</h2>
      <p class="mb-12 text-[14px] leading-[2] text-sub">最新の募集条件・詳細は、Indeedの求人ページをご確認ください。</p>
      <div class="rule-top max-w-[900px]">
        {requirements.map((r) => (
          <div class="rule-row grid gap-1 px-1 py-5 sm:grid-cols-[180px_1fr] sm:gap-6">
            <span class="text-[15px] font-black sm:text-base">{r.t}</span>
            <span class="whitespace-pre-line text-[14px] leading-[2] text-sub sm:text-[15px]">{r.d}</span>
          </div>
        ))}
      </div>
      <p class="mt-8 text-[12px] text-muted">※条件の詳細・最新情報はIndeedの掲載をご確認ください。面接時にもご説明します。</p>
    </div>
  </section>

  <!-- よくある質問 -->
  <section class="px-5 py-24 sm:px-10 sm:py-32">
    <div class="mx-auto max-w-content">
      <p class="en-label mb-8">FAQ</p>
      <h2 class="jp-title mb-14">よくある質問</h2>
      <div class="rule-top max-w-[900px]">
        {faqs.map((f) => (
          <div class="rule-row px-1 py-6">
            <p class="mb-2 text-[15px] font-black leading-[1.8] sm:text-base">Q. {f.q}</p>
            <p class="text-[14px] leading-[2] text-sub sm:text-[15px]">A. {f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 応募CTA -->
  <section class="bg-ink text-inkpaper">
    <div class="container-x py-24 text-center sm:py-32">
      <p class="en-label-dark mb-8" style="font-size:18px;letter-spacing:0.3em">Entry</p>
      <h2 class="mx-auto mb-5 max-w-3xl text-[26px] font-black leading-[1.5] text-white sm:text-4xl">まずは、話を聞くだけでも。</h2>
      <p class="mx-auto mb-12 max-w-xl text-[15px] leading-[2] text-inkmuted sm:text-base">
        ご応募・ご質問はIndeedの求人ページから受け付けています。見学のご相談もお気軽にどうぞ。
      </p>
      <div data-cta-source="recruit-entry">
        <a href={SITE.urls.recruit} target="_blank" rel="noopener" class="btn-amber-pill w-full max-w-md sm:w-auto sm:px-16 sm:py-6 sm:text-lg">Indeedで応募する</a>
      </div>
    </div>
  </section>
</Base>
