---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import { SITE } from '../consts';

const title = 'アクセス・店舗案内｜岐阜市長良｜全力ストレッチ岐阜長良店';
const description = '全力ストレッチ岐阜長良店へのアクセス。岐阜県岐阜市長良東２丁目３７ RSDビル2F南、ヤマダデンキ テックランド岐阜長良のすぐそば。駐車場10台以上、営業10:00-22:00・不定休。';

const mapQuery = encodeURIComponent(SITE.addressFull);

const rows = [
  { t: '住所', d: `${SITE.addressFull}（${SITE.landmark}）` },
  { t: '駐車場', d: SITE.parking },
  { t: '営業時間', d: `${SITE.hours}（${SITE.closed}）` },
  { t: '電話', d: SITE.tel, tel: true },
  { t: '運営', d: `${SITE.operator}（代表取締役 ${SITE.representative}）` },
];

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'アクセス・店舗案内', item: new URL('/access', Astro.site).href },
  ],
};
---
<Base title={title} description={description} path="/access" jsonld={[breadcrumb]}>
  <section class="subpage-hero section-grid mx-auto max-w-content border-b border-ink/20 px-5 pb-24 pt-16 sm:px-10 sm:pb-32 sm:pt-[120px]">
    <div class="mb-10 sm:mb-14"><Breadcrumbs items={[{ label: 'トップ', href: '/' }, { label: 'アクセス・店舗案内' }]} /></div>
    <h1 class="display-title mb-6">ACCESS</h1>
    <p class="mb-4 text-[26px] font-black sm:text-[36px]">ヤマダデンキ長良の、すぐそば。</p>
    <p class="mb-12 max-w-[820px] text-[15px] leading-[2.1] text-sub sm:mb-14 sm:text-[17px]">
      全力ストレッチ岐阜長良店は、岐阜市長良エリア・長良東のRSDビル2F南にあります。ビル東側に共同駐車場が10台以上あり、岐阜市外からもお車で通いやすい立地です。
    </p>

    <!-- 店舗外観（実写が用意でき次第 exterior.webp に差し替え） -->
    <img
      src="/images/photos/exterior.svg"
      alt="全力ストレッチ岐阜長良店の外観（RSDビル2F南・ヤマダデンキ テックランド岐阜長良そば）"
      width="1600" height="900" loading="lazy" decoding="async"
      class="mb-16 h-[260px] w-full object-cover sm:mb-20 sm:h-[440px]"
    />

    <div class="grid items-start gap-14 lg:grid-cols-2 lg:gap-[88px]">
      <div>
        <div class="rule-top text-base leading-[2]">
          {rows.map((r) => (
            <div class="rule-row grid grid-cols-[92px_1fr] gap-4 px-1 py-5 sm:grid-cols-[120px_1fr]">
              <span class="font-bold">{r.t}</span>
              {r.tel ? <a href={`tel:${SITE.telLink}`} class="text-sub underline">{r.d}</a> : <span class="text-sub">{r.d}</span>}
            </div>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap gap-5">
          <a href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener" class="btn-ink-pill">Googleマップで開く</a>
          <a href={SITE.urls.reserve} target="_blank" rel="noopener" class="btn-amber-pill">予約する</a>
        </div>
      </div>
      <iframe
        src={SITE.mapEmbed}
        title="全力ストレッチ岐阜長良店の周辺地図（岐阜市長良・ヤマダデンキ長良そば）"
        width="1200" height="700" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen
        class="aspect-[4/3] h-auto w-full border border-ink/15 bg-panel"
      ></iframe>
    </div>
  </section>

  <section class="border-t border-ink/15 bg-paper2 px-5 py-24 sm:px-10 sm:py-32">
    <div class="mx-auto max-w-content">
      <p class="en-label mb-8">Directions</p>
      <h2 class="jp-title mb-10">お越しの際の目印</h2>
      <div class="max-w-[820px] text-[15px] leading-[2.2] text-sub sm:text-base">
        <p class="mb-5">お車の場合は、ヤマダデンキ テックランド岐阜長良を目指してお越しください。すぐそばのRSDビル2F南が当店です。ビル東側の共同駐車場（10台以上）をご利用いただけます。ご不明な場合はお電話でご案内します。</p>
        <p>公共交通機関の最寄り情報（バス停・所要時間など）は {`{{最寄り}}`} に記載予定です。</p>
      </div>
    </div>
  </section>

  <ReserveCTA title="通いやすい長良で、まずは初回限定75%OFFでお試し。" />
</Base>
