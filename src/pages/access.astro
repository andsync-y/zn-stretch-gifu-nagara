---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import { SITE, LAST_UPDATED } from '../consts';

const title = 'アクセス・店舗案内｜岐阜市長良｜全力ストレッチ岐阜長良店';
const description = '全力ストレッチ岐阜長良店へのアクセス。岐阜県岐阜市長良東2-37 RSDビル2F南、ヤマダデンキ長良そば、駐車場10台以上。営業10:00-22:00、不定休。';

const mapQuery = encodeURIComponent(SITE.addressFull);

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'アクセス・店舗案内', item: new URL('/access', Astro.site).href },
  ],
};
---
<Base title={title} description={description} path="/access" jsonld={[breadcrumb]}>
  <Breadcrumbs items={[{ label: 'ホーム', href: '/' }, { label: 'アクセス・店舗案内' }]} />
  <header class="container-x pt-8 pb-10">
    <p class="eyebrow">ACCESS</p>
    <h1 class="mt-3 text-3xl font-black sm:text-4xl">アクセス・店舗案内</h1>
    <p class="prose-jp mt-5 max-w-2xl">
      全力ストレッチ岐阜長良店は、<span class="marker">岐阜市長良</span>エリア、
      ヤマダデンキ テックランド岐阜長良のすぐそばにあります。
      ビル東側に共同駐車場が10台以上あり、車で通いやすい立地です。
    </p>
  </header>

  <section class="container-x pb-10 grid gap-8 md:grid-cols-2">
    <div class="rounded-2xl border border-line p-7 text-sm leading-relaxed">
      <p class="font-heading text-lg font-bold text-ink">{SITE.brand}</p>
      <dl class="mt-5 grid grid-cols-[6rem_1fr] gap-y-3 text-charcoal">
        <dt class="text-charcoal/70">住所</dt><dd>{SITE.addressFull}</dd>
        <dt class="text-charcoal/70">最寄り・目印</dt><dd>{SITE.landmark}（{`{{最寄り}}`} も参照）</dd>
        <dt class="text-charcoal/70">電話</dt><dd><a href={`tel:${SITE.telLink}`} class="underline">{SITE.tel}</a></dd>
        <dt class="text-charcoal/70">営業時間</dt><dd>{SITE.hours}</dd>
        <dt class="text-charcoal/70">定休日</dt><dd>{SITE.closed}</dd>
        <dt class="text-charcoal/70">駐車場</dt><dd>{SITE.parking}（{`{{駐車場情報}}`}）</dd>
        <dt class="text-charcoal/70">運営</dt><dd>{SITE.operator}（代表取締役 {SITE.representative}）</dd>
      </dl>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener" class="btn-outline flex-1">Googleマップで開く</a>
        <a href={SITE.urls.reserve} target="_blank" rel="noopener" class="btn-amber flex-1">予約する</a>
      </div>
    </div>

    <div>
      <img src="/images/placeholder-map.svg" alt="全力ストレッチ岐阜長良店の周辺地図（岐阜市長良・ヤマダデンキ長良そば）" width="1200" height="700" loading="lazy" decoding="async" class="w-full rounded-2xl border border-line bg-panel object-cover" />
      <p class="mt-2 text-xs text-charcoal/60">
        ※本番では緯度経度（{SITE.geo.lat} / {SITE.geo.lng}）取得後にGoogleマップ埋め込みへ差し替え予定。
      </p>
    </div>
  </section>

  <section class="container-x py-12">
    <p class="eyebrow">DIRECTIONS</p>
    <h2 class="mt-2 text-2xl font-bold sm:text-3xl">お越しの際の目印</h2>
    <div class="prose-jp mt-6 max-w-3xl">
      <p>
        お車の場合は、ヤマダデンキ テックランド岐阜長良を目指してお越しください。すぐそばのRSDビル2F南が当店です。
        ビル東側の共同駐車場（10台以上）をご利用いただけます。駐車位置の詳細は、ご不明な場合はお電話でご案内します。
      </p>
      <p>
        公共交通機関でお越しの場合の最寄り情報（バス停・所要時間など）は{`{{最寄り}}`}に記載予定です。
        岐阜市長良エリアからはもちろん、周辺地域からも車でお越しいただけます。
      </p>
    </div>
    <p class="mt-8 text-xs text-charcoal/60">最終更新：{LAST_UPDATED}</p>
  </section>

  <ReserveCTA title="長良で、通いやすい完全個室ストレッチ" />
</Base>
