---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import { LAST_UPDATED } from '../consts';

const title = 'お客様の声｜岐阜市長良のパーソナルストレッチ｜全力ストレッチ岐阜長良店';
const description = '全力ストレッチ岐阜長良店に寄せられたお客様の声（準備中）。ご来店いただいた方の感想を、許可のうえ順次掲載します。捏造はしません。';

// お客様の声プレースホルダ（実データ投入まで空運用・捏造しない）
const placeholders = ['肩こり_1', '腰痛_1', '姿勢_1', 'スポーツ_1', '疲れ_1', 'むくみ_1'];

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'お客様の声', item: new URL('/voice', Astro.site).href },
  ],
};
---
<Base title={title} description={description} path="/voice" jsonld={[breadcrumb]}>
  {/*
    ============================================================
    Review / AggregateRating の JSON-LD ひな型（★実レビュー投入時に有効化）
    ------------------------------------------------------------
    実際にいただいた口コミが集まってから、下記のコメントを外し、
    reviewBody・author・ratingValue を「実データ」で埋めること。
    空データや創作データのまま出力しないこと（Google厳罰・捏造禁止）。

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": "（サイトURL）/#localbusiness",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "{{平均評価}}",
        "reviewCount": "{{レビュー件数}}"
      },
      "review": [
        {
          "@type": "Review",
          "author": { "@type": "Person", "name": "{{お客様の氏名またはニックネーム_1}}" },
          "reviewRating": { "@type": "Rating", "ratingValue": "{{評価_1}}", "bestRating": "5" },
          "reviewBody": "{{お客様の声_本文_1}}"
        }
      ]
    }
    </script>
    ============================================================
  */}
  <Breadcrumbs items={[{ label: 'ホーム', href: '/' }, { label: 'お客様の声' }]} />
  <header class="container-x pt-8 pb-10">
    <p class="eyebrow">VOICE</p>
    <h1 class="mt-3 text-3xl font-black sm:text-4xl">お客様の声</h1>
    <p class="prose-jp mt-5 max-w-2xl">
      2026年6月20日にオープンしたばかりの店舗です。ご来店いただいた方の声を、
      <span class="marker">ご本人の許可のうえ</span>、これから順次掲載していきます。
      当店では、事実にもとづかない感想の掲載（捏造）は一切行いません。
    </p>
  </header>

  <section class="container-x pb-10">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {placeholders.map((k) => (
        <figure class="rounded-2xl border border-dashed border-line p-6">
          <figcaption class="text-xs font-bold text-amber-700">掲載準備中（プレースホルダ）</figcaption>
          <blockquote class="mt-3 text-charcoal">{`{{お客様の声_${k}}}`}</blockquote>
          <p class="mt-4 text-xs text-charcoal/60">お悩みの種類：{k.split('_')[0]}</p>
        </figure>
      ))}
    </div>

    <div class="mt-10 rounded-2xl border border-line bg-offwhite p-6 text-sm text-charcoal">
      <p class="font-bold text-ink">ご来店いただいた方へ</p>
      <p class="mt-2">
        施術のご感想をお聞かせいただけると励みになります。GoogleやホットペッパーのクチコミからもOKです。
        いただいた声は、許可のうえ本ページや各お悩みページに掲載させていただくことがあります。
      </p>
    </div>
    <p class="mt-8 text-xs text-charcoal/60">最終更新：{LAST_UPDATED}</p>
  </section>

  <ReserveCTA title="あなたの「来てよかった」を、全力で" />
</Base>
