---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import { LAST_UPDATED } from '../consts';

const title = 'お客様の声｜岐阜市長良の完全個室パーソナルストレッチ専門店 全力ストレッチ岐阜長良店';
const description = '全力ストレッチ岐阜長良店に寄せられたお客様の声（準備中）。ご来店いただいた方の感想を、許可のうえ順次掲載します。実際のお客様の声のみを掲載します。';

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'お客様の声', item: new URL('/voice', Astro.site).href },
  ],
};
---
<Base title={title} description={description} path="/voice" jsonld={[breadcrumb]}>
  {/*
    ============================================================
    Review / AggregateRating の JSON-LD ひな型（★実レビュー投入時に有効化）
    ------------------------------------------------------------
    実際にいただいた口コミが集まってから、下記のコメントを外し、
    reviewBody・author・ratingValue を「実データ」で埋めること。
    空データや創作データのまま出力しないこと（Google厳罰・捏造禁止）。

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": "（サイトURL）/#localbusiness",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "{{平均評価}}",
        "reviewCount": "{{レビュー件数}}"
      },
      "review": [
        {
          "@type": "Review",
          "author": { "@type": "Person", "name": "{{お客様の氏名またはニックネーム_1}}" },
          "reviewRating": { "@type": "Rating", "ratingValue": "{{評価_1}}", "bestRating": "5" },
          "reviewBody": "{{お客様の声_本文_1}}"
        }
      ]
    }
    </script>
    ============================================================
  */}
  <section class="mx-auto max-w-content px-5 pb-24 pt-16 sm:px-10 sm:pb-32 sm:pt-[120px]">
    <div class="mb-10 sm:mb-14"><Breadcrumbs items={[{ label: 'トップ', href: '/' }, { label: 'お客様の声' }]} /></div>
    <h1 class="display-title mb-6">VOICE</h1>
    <p class="mb-4 text-[26px] font-black sm:text-[36px]">お客様の声</p>
    <p class="mb-16 max-w-[820px] text-[15px] leading-[2.1] text-sub sm:mb-20 sm:text-[17px]">
      2026年6月20日にオープンした店舗です。ご来店いただいた方の声を、ご本人の許可のうえ順次掲載していきます。当店では、事実にもとづかない感想の掲載は一切行いません。
    </p>

    <div class="border border-ink p-2">
      <div class="border border-ink px-6 py-14 sm:px-16 sm:py-[72px]">
        <p class="mb-10 text-center text-sm tracking-[0.08em] text-muted">Google マップのクチコミより</p>
        <div class="rounded border border-dashed border-[#D9D9D5] px-8 py-14 text-center">
          <p class="mb-3 text-lg font-black text-sub">掲載準備中</p>
          <p class="text-[15px] leading-[2.1] text-sub">
            クチコミが集まりしだい、このページに掲載します。<br />※実際のお客様の声のみを掲載します（{`{{お客様の声_◯◯_n}}`} プレースホルダ運用中）。
          </p>
        </div>
      </div>
    </div>

    <div class="mt-14 max-w-[820px] border-t border-ink pt-8">
      <h2 class="mb-3 text-[17px] font-black">ご来店いただいた方へ</h2>
      <p class="text-[15px] leading-[2.1] text-sub">
        施術のご感想をお聞かせいただけると励みになります。GoogleマップやホットペッパーのクチコミからもOKです。いただいた声は、許可のうえ本ページや各お悩みページに掲載させていただくことがあります。
      </p>
      <p class="mt-8 text-xs text-muted">最終更新：{LAST_UPDATED}</p>
    </div>
  </section>

  <ReserveCTA title="あなたの「来てよかった」を、全力で。" />
</Base>
