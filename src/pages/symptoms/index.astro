---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ReserveCTA from '../../components/ReserveCTA.astro';
import { SYMPTOMS } from '../../consts';

const title = 'お悩み別のご案内｜岐阜市長良の個室パーソナルストレッチ専門店 全力ストレッチ岐阜長良店';
const description = '肩こり・腰痛・猫背・むくみ・疲れ・スポーツケアなど、お悩み別にアプローチをご紹介。岐阜市長良の個室・マンツーマンのパーソナルストレッチ専門店。';

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'お悩み別', item: new URL('/symptoms', Astro.site).href },
  ],
};

const itemList = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  itemListElement: SYMPTOMS.map((s, i) => ({
    '@type': 'ListItem', position: i + 1, name: s.label,
    url: new URL(`/symptoms/${s.slug}`, Astro.site).href,
  })),
};
---
<Base title={title} description={description} path="/symptoms" jsonld={[breadcrumb, itemList]}>
  <section class="subpage-hero section-grid mx-auto max-w-content border-b border-ink/20 px-5 pb-24 pt-16 sm:px-10 sm:pb-32 sm:pt-[120px]">
    <div class="mb-10 sm:mb-14"><Breadcrumbs items={[{ label: 'トップ', href: '/' }, { label: 'お悩み別' }]} /></div>
    <p class="display-title mb-6">SYMPTOMS</p>
    <h1 class="mb-4 text-[26px] font-black sm:text-[36px]">お悩みから探す。<span class="sr-only">｜岐阜市長良のパーソナルストレッチ・お悩み別のご案内</span></h1>
    <p class="mb-16 max-w-[820px] text-[15px] leading-[2.1] text-sub sm:mb-20 sm:text-[17px]">
      全力ストレッチ岐阜長良店は、マッサージや整体とは違う、個室のパーソナルストレッチ専門店です。気になるお悩みに合わせて、アプローチの内容をご紹介します。
    </p>

    <div class="grid grid-cols-2 gap-x-5 gap-y-10 sm:gap-x-8 sm:gap-y-14 lg:grid-cols-4">
      {SYMPTOMS.map((s, i) => (
        <a href={`/symptoms/${s.slug}`} class="group relative flex flex-col overflow-hidden border-t border-ink pt-6 no-underline sm:pt-7">
          <span class="absolute left-0 top-0 h-[3px] w-0 bg-[#92745e] transition-all duration-500 group-hover:w-full" aria-hidden="true"></span>
          <span class="mb-2 font-script text-[9px] font-extrabold tracking-[0.18em] text-[#92745e]">{String(i + 1).padStart(2, '0')}</span>
          <span class="mb-2 text-[17px] font-black leading-[1.5] sm:text-[20px]">{s.label}</span>
          <span class="mb-4 flex-1 text-[12px] leading-[1.9] text-sub sm:text-[14px]">{s.desc}</span>
          <span class="text-right text-lg font-bold transition group-hover:text-amber-700" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <ReserveCTA title="どのお悩みも、まずは初回限定75%OFFでお試し。" source="symptom-index" />
</Base>
