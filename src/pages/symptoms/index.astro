---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ReserveCTA from '../../components/ReserveCTA.astro';
import { SYMPTOMS, LAST_UPDATED } from '../../consts';

const title = 'お悩み別のご案内｜岐阜市長良の完全個室パーソナルストレッチ専門店 全力ストレッチ岐阜長良店';
const description = '肩こり・腰痛・猫背・むくみ・疲れ・スポーツケアなど、お悩み別にアプローチをご紹介。岐阜市長良の完全個室・マンツーマンのパーソナルストレッチ専門店。';

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'お悩み別', item: new URL('/symptoms', Astro.site).href },
  ],
};

const itemList = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  itemListElement: SYMPTOMS.map((s, i) => ({
    '@type': 'ListItem', position: i + 1, name: s.label,
    url: new URL(`/symptoms/${s.slug}`, Astro.site).href,
  })),
};
---
<Base title={title} description={description} path="/symptoms" jsonld={[breadcrumb, itemList]}>
  <section class="mx-auto max-w-content px-5 pb-24 pt-16 sm:px-10 sm:pb-32 sm:pt-[120px]">
    <div class="mb-10 sm:mb-14"><Breadcrumbs items={[{ label: 'トップ', href: '/' }, { label: 'お悩み別' }]} /></div>
    <h1 class="display-title mb-6">SYMPTOMS</h1>
    <p class="mb-4 text-[26px] font-black sm:text-[36px]">お悩みから探す。</p>
    <p class="mb-16 max-w-[820px] text-[15px] leading-[2.1] text-sub sm:mb-20 sm:text-[17px]">
      全力ストレッチ岐阜長良店は、マッサージや整体とは違う、完全個室のパーソナルストレッチ専門店です。気になるお悩みに合わせて、アプローチの内容をご紹介します。
    </p>

    <div class="rule-top">
      {SYMPTOMS.map((s, i) => (
        <a href={`/symptoms/${s.slug}`} class="group grid grid-cols-[1fr_32px] items-baseline gap-4 border-b border-line px-2 py-6 no-underline sm:grid-cols-[70px_280px_1fr_32px] sm:gap-8 sm:py-8">
          <span class="hidden font-display text-sm italic text-faint sm:block">{String(i + 1).padStart(2, '0')}</span>
          <span class="text-[19px] font-black sm:text-[22px]">{s.label}</span>
          <span class="col-span-2 text-[14px] leading-[2] text-sub sm:col-span-1 sm:text-[15px]">{s.desc}</span>
          <span class="hidden text-right text-lg font-bold transition group-hover:text-amber-700 sm:block" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
    <p class="mt-10 text-xs text-muted">最終更新：{LAST_UPDATED}</p>
  </section>

  <ReserveCTA title="どのお悩みも、まずは初回3,300円から。" />
</Base>
