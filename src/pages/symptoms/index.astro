---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ReserveCTA from '../../components/ReserveCTA.astro';
import { SYMPTOMS, LAST_UPDATED } from '../../consts';

// お悩み別の線画アイコン（デザインの手描き風ストロークに合わせたSVG）
const stroke = 'fill="none" stroke="#1A1A1A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"';
const ICONS: Record<string, string> = {
  katakori: `<svg viewBox="0 0 96 96" ${stroke} role="img" aria-hidden="true"><circle cx="48" cy="26" r="10"/><path d="M20 64 C28 48,68 48,76 64"/><path d="M26 38 L20 30 M32 34 L28 25"/><path d="M70 38 L76 30 M64 34 L68 25"/></svg>`,
  youtsu: `<svg viewBox="0 0 96 96" ${stroke} role="img" aria-hidden="true"><circle cx="58" cy="20" r="9"/><path d="M56 29 C44 38,40 50,42 66 L40 80"/><path d="M58 50 C52 50,48 54,47 58"/><path d="M64 54 L74 50 M66 62 L76 62 M64 70 L73 74"/></svg>`,
  'kubi-ganseihiro': `<svg viewBox="0 0 96 96" ${stroke} role="img" aria-hidden="true"><path d="M30 40 C36 30,60 30,66 40 C60 50,36 50,30 40 Z"/><circle cx="48" cy="40" r="4"/><path d="M42 60 L40 76 M54 60 L56 76"/><path d="M28 20 L22 12 M48 16 L48 8 M68 20 L74 12"/></svg>`,
  mukumi: `<svg viewBox="0 0 96 96" ${stroke} role="img" aria-hidden="true"><path d="M38 12 C42 28,42 42,36 58 C34 64,34 72,38 80 L56 80"/><path d="M70 22 C70 22,78 32,78 38 A8 8 0 1 1 62 38 C62 32,70 22,70 22 Z"/><path d="M70 56 V72 M62 60 L78 68 M78 60 L62 68"/></svg>`,
  jiritsu: `<svg viewBox="0 0 96 96" ${stroke} role="img" aria-hidden="true"><path d="M58 18 A26 26 0 1 0 84 48 A21 21 0 0 1 58 18 Z"/><path d="M22 22 H36 L22 36 H36"/><path d="M18 50 H28 L18 60 H28"/></svg>`,
  shisei: `<svg viewBox="0 0 96 96" ${stroke} role="img" aria-hidden="true"><path d="M66 12 V82" stroke-dasharray="4 7"/><circle cx="34" cy="26" r="9"/><path d="M38 34 C48 42,48 56,40 66 L38 80"/><path d="M40 48 C34 48,30 52,29 56"/></svg>`,
  sports: `<svg viewBox="0 0 96 96" ${stroke} role="img" aria-hidden="true"><circle cx="42" cy="16" r="8"/><path d="M42 24 L46 46"/><path d="M46 32 C56 24,66 22,74 26 L84 18"/><path d="M46 46 L36 76 M46 46 L58 74"/><path d="M16 34 A36 36 0 0 1 34 12" stroke-dasharray="4 7"/></svg>`,
};

const title = 'お悩み別のご案内｜岐阜市長良の完全個室パーソナルストレッチ専門店 全力ストレッチ岐阜長良店';
const description = '肩こり・腰痛・猫背・むくみ・疲れ・スポーツケアなど、お悩み別にアプローチをご紹介。岐阜市長良の完全個室・マンツーマンのパーソナルストレッチ専門店。';

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'お悩み別', item: new URL('/symptoms', Astro.site).href },
  ],
};

const itemList = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  itemListElement: SYMPTOMS.map((s, i) => ({
    '@type': 'ListItem', position: i + 1, name: s.label,
    url: new URL(`/symptoms/${s.slug}`, Astro.site).href,
  })),
};
---
<Base title={title} description={description} path="/symptoms" jsonld={[breadcrumb, itemList]}>
  <section class="mx-auto max-w-content px-5 pb-24 pt-16 sm:px-10 sm:pb-32 sm:pt-[120px]">
    <div class="mb-10 sm:mb-14"><Breadcrumbs items={[{ label: 'トップ', href: '/' }, { label: 'お悩み別' }]} /></div>
    <h1 class="display-title mb-6">SYMPTOMS</h1>
    <p class="mb-4 text-[26px] font-black sm:text-[36px]">お悩みから探す。</p>
    <p class="mb-16 max-w-[820px] text-[15px] leading-[2.1] text-sub sm:mb-20 sm:text-[17px]">
      全力ストレッチ岐阜長良店は、マッサージや整体とは違う、完全個室のパーソナルストレッチ専門店です。気になるお悩みに合わせて、アプローチの内容をご紹介します。
    </p>

    <div class="grid grid-cols-2 gap-x-5 gap-y-10 sm:gap-x-8 sm:gap-y-14 lg:grid-cols-4">
      {SYMPTOMS.map((s, i) => (
        <a href={`/symptoms/${s.slug}`} class="group flex flex-col border-t border-ink pt-6 no-underline sm:pt-7">
          <span class="mb-5 block h-[72px] w-[72px] sm:h-[88px] sm:w-[88px]" set:html={ICONS[s.slug]} />
          <span class="mb-2 font-display text-sm italic text-faint">{String(i + 1).padStart(2, '0')}</span>
          <span class="mb-2 text-[17px] font-black leading-[1.5] sm:text-[20px]">{s.label}</span>
          <span class="mb-4 flex-1 text-[12px] leading-[1.9] text-sub sm:text-[14px]">{s.desc}</span>
          <span class="text-right text-lg font-bold transition group-hover:text-amber-700" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
    <p class="mt-10 text-xs text-muted">最終更新：{LAST_UPDATED}</p>
  </section>

  <ReserveCTA title="どのお悩みも、まずは初回3,300円から。" />
</Base>
