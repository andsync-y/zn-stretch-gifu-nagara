---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ReserveCTA from '../../components/ReserveCTA.astro';
import { SYMPTOMS, LAST_UPDATED } from '../../consts';

const title = 'お悩み別のご案内｜岐阜市長良のパーソナルストレッチ｜全力ストレッチ岐阜長良店';
const description = '肩こり・腰痛・猫背・むくみ・疲れ・スポーツケアなど、お悩み別にご案内。岐阜市長良の完全個室パーソナルストレッチ専門店。';

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'お悩み別', item: new URL('/symptoms', Astro.site).href },
  ],
};

const itemList = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  itemListElement: SYMPTOMS.map((s, i) => ({
    '@type': 'ListItem', position: i + 1, name: s.label,
    url: new URL(`/symptoms/${s.slug}`, Astro.site).href,
  })),
};
---
<Base title={title} description={description} path="/symptoms" jsonld={[breadcrumb, itemList]}>
  <Breadcrumbs items={[{ label: 'ホーム', href: '/' }, { label: 'お悩み別' }]} />
  <header class="container-x pt-8 pb-10">
    <p class="eyebrow">SYMPTOMS</p>
    <h1 class="mt-3 text-3xl font-black sm:text-4xl">お悩み別のご案内</h1>
    <p class="prose-jp mt-5 max-w-2xl">
      肩こり・腰痛・姿勢など、気になるお悩みからご覧ください。
      全力ストレッチ岐阜長良店は、マッサージや整体とは違う<span class="marker">完全個室のパーソナルストレッチ</span>専門店です。
      それぞれのお悩みに合わせて、担当トレーナーがマンツーマンでアプローチします。
    </p>
  </header>

  <section class="container-x pb-10">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {SYMPTOMS.map((s) => (
        <a href={`/symptoms/${s.slug}`} class="group flex flex-col rounded-2xl border border-line p-7 transition hover:border-ink/40">
          <p class="font-heading text-xl font-bold group-hover:text-amber-700">{s.label}</p>
          <p class="mt-3 flex-1 text-sm text-charcoal">{s.desc}</p>
          <span class="mt-5 inline-block text-sm text-amber-700">詳しく見る →</span>
        </a>
      ))}
    </div>
    <p class="mt-8 text-xs text-charcoal/60">最終更新：{LAST_UPDATED}</p>
  </section>

  <ReserveCTA title="お悩みに合わせて、マンツーマンで" />
</Base>
