---
// 料金表示（症状ページ・料金ページ共用）
import { PRICING } from '../consts';
export interface Props {
  compact?: boolean;
  showCaption?: boolean;
  showBadge?: boolean;
}
const { compact = false, showCaption = true, showBadge = true } = Astro.props;
const courses = compact ? PRICING.courses.filter((course) => course.primary) : PRICING.courses;
---
<div class="price-table">
  {showBadge && <p class="price-badge">FIRST SESSION <strong>最大75%OFF</strong></p>}
  <div class="price-list">
    {courses.map((course, index) => (
      <div class="price-row">
        <span class="price-no">{String(index + 1).padStart(2, '0')}</span>
        <div class="price-name">
          <strong>{course.name}</strong>
          <span>{course.label}</span>
        </div>
        <div class="price-before">
          <span>{course.discount}</span>
          <del>{course.normal}</del>
        </div>
        <p class="price-first">
          <strong>{course.firstPlain}</strong><span>円</span><small>税込</small>
        </p>
      </div>
    ))}
  </div>
  {showCaption && <p class="price-caption">{PRICING.caption}<br />※{PRICING.note}</p>}
</div>

<style>
  .price-badge {
    display: inline-flex;
    margin: 0 0 22px;
    padding: 7px 10px;
    align-items: center;
    gap: 12px;
    background: #151719;
    color: #fff;
    font-family: "Inter", sans-serif;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .price-badge strong {
    padding-left: 12px;
    border-left: 1px solid rgba(255,255,255,0.4);
    color: #d0bba9;
    font-size: 11px;
  }

  .price-list { border-top: 2px solid #151719; }

  .price-row {
    display: grid;
    grid-template-columns: 45px minmax(150px, 1fr) 100px minmax(150px, auto);
    min-height: 112px;
    padding: 18px 3px;
    align-items: center;
    gap: 16px;
    border-bottom: 1px solid rgba(21,23,25,0.35);
  }

  .price-no {
    color: #9a7f6b;
    font-family: "Inter", sans-serif;
    font-size: 9px;
    font-weight: 800;
  }

  .price-name strong,
  .price-name span { display: block; }

  .price-name strong {
    margin-bottom: 4px;
    font-size: 17px;
    font-weight: 900;
  }

  .price-name span {
    color: #676d71;
    font-size: 12px;
    font-weight: 700;
  }

  .price-before span {
    display: block;
    width: max-content;
    margin-bottom: 7px;
    padding: 2px 6px;
    background: #92745e;
    color: #fff;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .price-before del {
    color: #858b8f;
    font-size: 11px;
  }

  .price-first {
    margin: 0;
    text-align: right;
    white-space: nowrap;
  }

  .price-first strong {
    font-family: "Archivo Black", "Noto Sans JP", sans-serif;
    font-size: clamp(34px, 4vw, 53px);
    letter-spacing: -0.07em;
    line-height: 1;
  }

  .price-first > span {
    margin-left: 3px;
    font-size: 12px;
    font-weight: 900;
  }

  .price-first small {
    margin-left: 4px;
    color: #777d81;
    font-size: 8px;
  }

  .price-caption {
    margin: 16px 0 0;
    color: #686e72;
    font-size: 11px;
    line-height: 1.9;
  }

  @media (max-width: 640px) {
    .price-row {
      grid-template-columns: 28px 1fr auto;
      min-height: 96px;
      gap: 9px;
    }

    .price-before { display: none; }
    .price-name strong { font-size: 14px; }
    .price-name span { font-size: 10px; }
    .price-first strong { font-size: 31px; }
  }
</style>
