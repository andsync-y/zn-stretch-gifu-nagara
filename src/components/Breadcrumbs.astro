---
export interface Crumb { label: string; href?: string; }
export interface Props { items: Crumb[]; }
const { items } = Astro.props;
---
<nav aria-label="パンくずリスト" class="container-x pt-6">
  <ol class="flex flex-wrap items-center gap-1 text-xs text-charcoal/70">
    {items.map((c, i) => (
      <li class="flex items-center gap-1">
        {c.href ? <a href={c.href} class="hover:text-amber-700">{c.label}</a> : <span aria-current="page">{c.label}</span>}
        {i < items.length - 1 && <span aria-hidden="true">›</span>}
      </li>
    ))}
  </ol>
</nav>
