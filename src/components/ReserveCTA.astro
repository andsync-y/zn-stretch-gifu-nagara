---
import { SITE } from '../consts';
export interface Props {
  title?: string;
  sub?: string;
  /** trueならトップ用の大きいレイアウト（ロゴ入り） */
  large?: boolean;
}
const {
  title = 'まずは、初回限定75%OFFでお試し。',
  sub = '初回限定75%OFFでご案内／完全個室・マンツーマン',
  large = false,
} = Astro.props;
---
<section class="bg-ink text-inkpaper" id="reserve">
  <div class="container-x py-24 text-center sm:py-32">
    <p class="en-label-dark mb-8 sm:mb-11" style="font-size:18px;letter-spacing:0.3em">Reservation</p>
    {large && (
      <p class="mb-10 flex justify-center">
        <img src="/images/logo.png" alt="全力ストレッチ" width="1200" height="307" class="h-auto w-[320px] invert sm:w-[520px]" loading="lazy" decoding="async" />
      </p>
    )}
    <h2 class="mx-auto mb-5 max-w-3xl text-[26px] font-black leading-[1.5] text-white sm:text-4xl">{title}</h2>
    <p class="mx-auto mb-12 max-w-xl text-[15px] leading-[2] text-inkmuted sm:mb-16 sm:text-base">{sub}</p>
    <div class="flex flex-col items-center gap-9">
      <a href={SITE.urls.reserve} target="_blank" rel="noopener" class="btn-amber-pill w-full max-w-md sm:w-auto sm:px-16 sm:py-6 sm:text-lg">WEB予約はこちら</a>
      <div class="flex flex-col items-center gap-4 text-[15px] text-inkpaper/90 sm:flex-row sm:gap-12">
        <a href={SITE.urls.line} target="_blank" rel="noopener" class="border-b border-white/50 pb-1">LINEで予約・相談</a>
        <a href={`tel:${SITE.telLink}`}>TEL {SITE.tel}（{SITE.hours}・{SITE.closed}）</a>
      </div>
    </div>
  </div>
</section>
