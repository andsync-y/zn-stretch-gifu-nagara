---
import { PRICING, SITE } from '../consts';
export interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const plans = [PRICING.min60, PRICING.min90];
---
<div class={compact ? '' : 'rounded-2xl border border-line bg-offwhite p-6 sm:p-8'}>
  {!compact && (
    <div class="mb-6">
      <p class="eyebrow">FIRST VISIT</p>
      <h3 class="mt-2 text-xl font-bold sm:text-2xl"><span class="marker">初回限定75%OFF</span> でお試しいただけます</h3>
    </div>
  )}
  <div class="grid gap-4 sm:grid-cols-2">
    {plans.map((p) => (
      <div class="rounded-xl border border-line bg-base p-5">
        <p class="font-heading text-lg font-bold">パーソナルストレッチ {p.label}</p>
        <p class="mt-3 flex flex-wrap items-baseline gap-2">
          <span class="text-charcoal/60 line-through">{p.normal}</span>
          <span aria-hidden="true">→</span>
          <span class="text-3xl font-black text-amber-700">{p.first}</span>
        </p>
        <p class="mt-1 text-sm font-bold text-amber-700">{p.discount}（初回のご来店時）</p>
      </div>
    ))}
  </div>
  <p class="mt-4 text-xs text-charcoal/70">※{PRICING.note} 表示は税込です。初回価格は初めてご来店の方が対象です。</p>
  <div class="mt-6 flex flex-col gap-3 sm:flex-row">
    <a href={SITE.urls.reserve} target="_blank" rel="noopener" class="btn-amber flex-1">ホットペッパーで初回予約する</a>
    <a href="/menu" class="btn-outline flex-1">料金の詳細を見る</a>
  </div>
</div>
