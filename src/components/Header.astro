---
import { SITE, SYMPTOMS } from '../consts';

const nav = [
  { label: 'Concept', href: '/#concept' },
  { label: 'Method', href: '/#method' },
  { label: 'Symptoms', href: '/symptoms' },
  { label: 'Staff', href: '/staff' },
  { label: 'Price', href: '/menu' },
];
---
<header class="bg-paper">
  <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between px-5 sm:h-[92px] sm:px-10 xl:px-14">
    <a href="/" class="flex items-center gap-3 sm:gap-4" aria-label={`${SITE.brand} トップへ`}>
      <img src="/images/logo.png" alt="全力ストレッチ PHYSICAL CONDITIONING SALON" width="1200" height="307" class="h-7 w-auto sm:h-9" />
      <span class="hidden text-[15px] font-medium tracking-[0.24em] text-muted sm:inline sm:text-[17px]">岐阜長良店</span>
    </a>

    <nav class="hidden items-center gap-9 text-[13px] font-medium tracking-[0.12em] lg:flex" aria-label="メインナビゲーション">
      {nav.map((n) => <a href={n.href} class="transition hover:text-amber-700">{n.label}</a>)}
      <a href={SITE.urls.reserve} target="_blank" rel="noopener" class="bg-ink px-7 py-3 text-[13px] font-bold tracking-[0.14em] text-paper transition hover:bg-black">ご予約</a>
    </nav>

    <a href={SITE.urls.reserve} target="_blank" rel="noopener" class="bg-ink px-5 py-2.5 text-xs font-bold tracking-[0.12em] text-paper lg:hidden">ご予約</a>
  </div>

  <!-- モバイル：お悩み別サブナビ（JSなしで到達性確保） -->
  <nav class="border-y border-ink/10 lg:hidden" aria-label="お悩み別ナビゲーション">
    <ul class="flex gap-5 overflow-x-auto px-5 py-2.5 text-[13px]">
      <li><a href="/symptoms" class="whitespace-nowrap font-bold">お悩み別</a></li>
      {SYMPTOMS.map((s) => (
        <li><a href={`/symptoms/${s.slug}`} class="whitespace-nowrap text-sub">{s.short}</a></li>
      ))}
      <li><a href="/menu" class="whitespace-nowrap text-sub">料金</a></li>
      <li><a href="/access" class="whitespace-nowrap text-sub">アクセス</a></li>
    </ul>
  </nav>
</header>
