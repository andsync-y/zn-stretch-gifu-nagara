---
import { SITE, SYMPTOMS } from '../consts';

const nav = [
  { label: 'Concept', href: '/#concept' },
  { label: 'Method', href: '/#method' },
  { label: 'Symptoms', href: '/symptoms' },
  { label: 'Staff', href: '/staff' },
  { label: 'Price', href: '/menu' },
];

const menuLinks = [
  { label: 'メニュー・料金', href: '/menu' },
  { label: 'スタッフ紹介', href: '/staff' },
  { label: 'お客様の声', href: '/voice' },
  { label: 'アクセス・店舗案内', href: '/access' },
  { label: 'ご予約について', href: '/reserve' },
];
---
<!-- フローティングヘッダー（スクロール追従・背景ぼかし） -->
<header class="sticky top-0 z-50 border-b border-ink/10 bg-paper/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between px-5 sm:h-[76px] sm:px-10 xl:px-14">
    <a href="/" class="flex items-center gap-3 sm:gap-4" aria-label={`${SITE.brand} トップへ`}>
      <img src="/images/logo.png" alt="全力ストレッチ PHYSICAL CONDITIONING SALON" width="1200" height="307" class="h-7 w-auto sm:h-8" />
      <span class="text-[13px] font-medium tracking-[0.18em] text-muted sm:text-[15px] sm:tracking-[0.24em]">岐阜長良店</span>
    </a>

    <nav class="hidden items-center gap-9 text-[13px] font-medium tracking-[0.12em] lg:flex" aria-label="メインナビゲーション">
      {nav.map((n) => <a href={n.href} class="transition hover:text-amber-700">{n.label}</a>)}
      <a href={SITE.urls.reserve} target="_blank" rel="noopener" class="bg-ink px-7 py-3 text-[13px] font-bold tracking-[0.14em] text-paper transition hover:bg-black">ご予約</a>
    </nav>

    <div class="flex items-center gap-4 lg:hidden">
      <a href={SITE.urls.reserve} target="_blank" rel="noopener" class="bg-ink px-4 py-2.5 text-xs font-bold tracking-[0.12em] text-paper">ご予約</a>
      <button id="menu-toggle" type="button" class="flex flex-col items-center gap-1 pt-0.5" aria-expanded="false" aria-controls="mobile-menu" aria-label="メニューを開く">
        <span class="flex flex-col gap-[5px]">
          <span class="block h-[1.5px] w-[24px] bg-ink"></span>
          <span class="block h-[1.5px] w-[24px] bg-ink"></span>
        </span>
        <span class="text-[10px] tracking-[0.08em]">menu</span>
      </button>
    </div>
  </div>

  <!-- モバイル：ドロワーメニュー -->
  <div id="mobile-menu" class="hidden border-t border-ink/10 bg-paper lg:!hidden">
    <nav class="px-5 py-6" aria-label="モバイルメニュー">
      <p class="en-label mb-3" style="font-size:12px">Symptoms</p>
      <ul class="mb-6 grid grid-cols-2 gap-x-4 gap-y-2.5 text-[14px]">
        {SYMPTOMS.map((s) => (
          <li><a href={`/symptoms/${s.slug}`} class="text-sub">{s.label}</a></li>
        ))}
      </ul>
      <p class="en-label mb-3" style="font-size:12px">Information</p>
      <ul class="mb-6 grid grid-cols-2 gap-x-4 gap-y-2.5 text-[14px]">
        {menuLinks.map((m) => (
          <li><a href={m.href} class="text-sub">{m.label}</a></li>
        ))}
      </ul>
      <a href={SITE.urls.reserve} target="_blank" rel="noopener" class="btn-ink block w-full text-center !py-4 text-[14px]">WEB予約はこちら</a>
    </nav>
  </div>
</header>

<!-- モバイル：お悩み別サブナビ（固定しない・JSなしで到達性確保） -->
<nav class="border-b border-ink/10 bg-paper lg:hidden" aria-label="お悩み別ナビゲーション">
  <ul class="flex gap-5 overflow-x-auto px-5 py-2.5 text-[13px]">
    <li><a href="/symptoms" class="whitespace-nowrap font-bold">お悩み別</a></li>
    {SYMPTOMS.map((s) => (
      <li><a href={`/symptoms/${s.slug}`} class="whitespace-nowrap text-sub">{s.short}</a></li>
    ))}
    <li><a href="/menu" class="whitespace-nowrap text-sub">料金</a></li>
    <li><a href="/access" class="whitespace-nowrap text-sub">アクセス</a></li>
  </ul>
</nav>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
  });
</script>
