---
import { SITE, SYMPTOMS } from '../consts';
---
<footer class="border-t border-ink/10 bg-paper">
  <!-- 内部リンク（SEO・回遊用の控えめな行） -->
  <nav class="container-x flex flex-wrap gap-x-6 gap-y-2 pt-10 text-[13px] text-sub" aria-label="フッターナビゲーション">
    {SYMPTOMS.map((s) => <a href={`/symptoms/${s.slug}`} class="hover:text-amber-700">{s.label}</a>)}
    <a href="/menu" class="hover:text-amber-700">メニュー・料金</a>
    <a href="/staff" class="hover:text-amber-700">スタッフ</a>
    <a href="/voice" class="hover:text-amber-700">お客様の声</a>
    <a href="/access" class="hover:text-amber-700">アクセス</a>
    <a href="/reserve" class="hover:text-amber-700">ご予約</a>
    <a href={SITE.urls.instagram} target="_blank" rel="noopener" class="hover:text-amber-700">Instagram</a>
  </nav>

  <div class="container-x flex flex-col justify-between gap-8 py-10 sm:py-12 md:flex-row md:items-start">
    <div>
      <div class="mb-2 flex items-baseline gap-3">
        <img src="/images/logo.png" alt="" width="1200" height="307" class="h-6 w-auto" loading="lazy" decoding="async" />
        <span class="text-[13px] font-bold">全力ストレッチ 岐阜長良店</span>
      </div>
      <p class="text-[13px] leading-[2.1] text-muted">
        {SITE.addressFull}　／　{SITE.hours}（{SITE.closed}）　／　<a href={`tel:${SITE.telLink}`} class="underline">{SITE.tel}</a><br />
        駐車場：{SITE.parking}　／　運営：{SITE.operator}
      </p>
    </div>
    <p class="text-[12px] leading-[2.1] text-muted md:text-right">
      ※当店はリラクゼーションを目的としたストレッチ専門店であり、<br class="hidden md:block" />医療行為を行う施設ではありません。<br />
      © 全力ストレッチ 岐阜長良店
    </p>
  </div>
</footer>
