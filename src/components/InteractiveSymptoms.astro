---
import { SYMPTOMS } from '../consts';

const meta = {
  katakori: { key: 'shoulder' },
  youtsu: { key: 'lower-back' },
  'kubi-ganseihiro': { key: 'neck-eyes' },
  mukumi: { key: 'lower-legs' },
  jiritsu: { key: 'whole-body' },
  shisei: { key: 'upper-back' },
  sports: { key: 'kinetic-chain' },
} as const;

const symptoms = SYMPTOMS.map((item, index) => ({
  ...item,
  id: String(index + 1).padStart(2, '0'),
  href: `/symptoms/${item.slug}`,
  ...meta[item.slug as keyof typeof meta],
}));

const hotspots = [
  { key: 'shoulder', x: 50, y: 20, w: 30, h: 14 },
  { key: 'lower-back', x: 52, y: 39, w: 26, h: 15 },
  { key: 'lower-back', x: 52, y: 47, w: 30, h: 15, delay: 120 },
  { key: 'neck-eyes', x: 49, y: 16, w: 20, h: 14 },
  { key: 'neck-eyes', x: 45, y: 8, w: 13, h: 9, delay: 100 },
  { key: 'lower-legs', x: 45, y: 80, w: 15, h: 24 },
  { key: 'lower-legs', x: 56, y: 79, w: 15, h: 24, delay: 100 },
  { key: 'whole-body', x: 50, y: 38, w: 46, h: 46 },
  { key: 'upper-back', x: 51, y: 27, w: 32, h: 20 },
  { key: 'kinetic-chain', x: 49, y: 20, w: 22, h: 13 },
  { key: 'kinetic-chain', x: 53, y: 46, w: 24, h: 16, delay: 90 },
  { key: 'kinetic-chain', x: 45, y: 67, w: 16, h: 14, delay: 180 },
];
---

<div class="symptoms-explorer" data-symptoms-explorer data-active="shoulder">
  <div class="symptoms-visual" aria-hidden="true">
    <div class="symptoms-body">
      <img
        class="symptoms-anatomy"
        src="/images/symptoms/anatomy-base.webp"
        alt=""
        width="921"
        height="1708"
        loading="lazy"
        decoding="async"
      />
      <div class="symptoms-hotspots">
        {hotspots.map((spot) => (
          <span
            class:list={['symptom-hotspot', spot.key === 'shoulder' && 'is-active']}
            data-hotspot={spot.key}
            style={`--x:${spot.x}%;--y:${spot.y}%;--w:${spot.w}%;--h:${spot.h}%;--delay:${spot.delay ?? 0}ms`}
          ></span>
        ))}
      </div>
    </div>
  </div>

  <div class="symptoms-list" aria-label="お悩みを選ぶ">
    {symptoms.map((item) => (
      <a
        class:list={['symptom-entry', item.id === '01' && 'is-active']}
        href={item.href}
        data-symptom-entry={item.key}
        aria-label={`${item.label}（${item.note}）を詳しく見る`}
      >
        <span class="symptom-trigger">
          <span class="symptom-no">{item.id}</span>
          <span class="symptom-copy">
            <strong>{item.label}</strong>
            <small>{item.note}</small>
          </span>
        </span>
        <span class="symptom-link" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</div>

<script>
  const explorer = document.querySelector<HTMLElement>('[data-symptoms-explorer]');

  if (explorer) {
    const entries = [...explorer.querySelectorAll<HTMLElement>('[data-symptom-entry]')];
    const hotspots = [...explorer.querySelectorAll<HTMLElement>('[data-hotspot]')];
    const desktopHover = matchMedia('(min-width: 768px) and (hover: hover)');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

    const setActive = (key: string) => {
      explorer.dataset.active = key;
      entries.forEach((entry) => entry.classList.toggle('is-active', entry.dataset.symptomEntry === key));
      hotspots.forEach((hotspot) => hotspot.classList.toggle('is-active', hotspot.dataset.hotspot === key));
    };

    entries.forEach((entry) => {
      const key = entry.dataset.symptomEntry ?? 'shoulder';
      // 各行はリンク（クリック・タップで詳細ページへ遷移）。PCはホバー／キーボードフォーカスで該当部位をハイライト
      entry.addEventListener('pointerenter', () => {
        if (desktopHover.matches) setActive(key);
      });
      entry.addEventListener('focusin', () => setActive(key));
    });

    setActive('shoulder');

    // ホバーが効かない端末（スマホ等）では、1秒ごとに項目を自動で切り替え、
    // 対応する骨格のホットスポット（赤）も一緒に移動させる。
    const keys = entries.map((entry) => entry.dataset.symptomEntry ?? 'shoulder');
    let autoTimer: number | null = null;
    let cursor = 0;

    const autoAllowed = () => !desktopHover.matches && !reduceMotion.matches && keys.length > 1;

    const startAuto = () => {
      if (autoTimer !== null || !autoAllowed()) return;
      autoTimer = window.setInterval(() => {
        cursor = (cursor + 1) % keys.length;
        setActive(keys[cursor]);
      }, 1000);
    };

    const stopAuto = () => {
      if (autoTimer !== null) {
        clearInterval(autoTimer);
        autoTimer = null;
      }
    };

    // 表示中だけ回す（画面外では止めて無駄な更新を避ける）
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (records) => records.forEach((record) => (record.isIntersecting ? startAuto() : stopAuto())),
        { threshold: 0.25 },
      );
      io.observe(explorer);
    } else {
      startAuto();
    }

    // 入力方式・モーション設定の変化に追従（PCへ切替時などは自動送りを止めて初期表示へ）
    const syncMode = () => {
      if (autoAllowed()) {
        startAuto();
      } else {
        stopAuto();
        cursor = 0;
        setActive(keys[0] ?? 'shoulder');
      }
    };
    desktopHover.addEventListener('change', syncMode);
    reduceMotion.addEventListener('change', syncMode);
  }
</script>

<style>
  .symptoms-explorer {
    --symptom-red: #ef3f37;
    display: grid;
    grid-template-columns: minmax(0, 500px) minmax(0, 1fr);
    gap: clamp(32px, 4vw, 72px);
    min-height: clamp(560px, 72vh, 760px);
    align-items: stretch;
  }

  .symptoms-visual {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: #151719;
  }

  .symptoms-body {
    position: absolute;
    left: 50%;
    top: 50%;
    width: auto;
    height: 100%;
    max-width: 100%;
    aspect-ratio: 921 / 1708;
    transform: translate(-50%, -50%);
  }

  .symptoms-anatomy,
  .symptoms-hotspots {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .symptoms-anatomy {
    object-fit: contain;
    filter: contrast(1.04) brightness(.96);
  }

  .symptoms-hotspots {
    pointer-events: none;
  }

  .symptom-hotspot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(255, 48, 40, .96) 0%, rgba(238, 47, 40, .58) 34%, rgba(213, 31, 27, .18) 58%, transparent 76%);
    box-shadow: 0 0 18px rgba(239, 63, 55, .62), 0 0 44px rgba(239, 63, 55, .28);
    mix-blend-mode: screen;
    opacity: 0;
    transform: translate(-50%, -50%) scale(.72);
    transition: opacity 320ms ease, transform 480ms cubic-bezier(.22, 1, .36, 1);
  }

  .symptom-hotspot.is-active {
    opacity: .92;
    transform: translate(-50%, -50%) scale(1);
  }

  .symptoms-list {
    align-self: center;
    border-top: 1px solid rgba(255, 255, 255, .5);
  }

  .symptom-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 48px;
    min-height: 68px;
    border-bottom: 1px solid rgba(255, 255, 255, .2);
    color: #f4f0e9;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 220ms ease;
  }

  .symptom-entry.is-active {
    background: rgba(239, 63, 55, .075);
  }

  .symptom-trigger {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    padding: 10px 6px 10px 2px;
  }

  .symptom-entry:focus-visible {
    outline: 2px solid var(--symptom-red);
    outline-offset: -2px;
  }

  .symptom-no {
    align-self: start;
    padding-top: 4px;
    color: #85817c;
    font-family: 'Inter', sans-serif;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .14em;
    transition: color 220ms ease;
  }

  .symptom-copy strong {
    display: block;
    font-size: clamp(14px, 1.2vw, 17px);
    font-weight: 900;
    line-height: 1.4;
    transition: color 220ms ease;
  }

  .symptom-copy small {
    display: block;
    margin-top: 2px;
    color: #97928c;
    font-size: 10px;
    line-height: 1.45;
  }

  .symptom-link {
    display: grid;
    place-items: center;
    border-left: 1px solid rgba(255, 255, 255, .12);
    color: #f4f0e9;
    font-size: 17px;
    text-decoration: none;
    transition: color 220ms ease, transform 220ms ease;
  }

  .symptom-entry.is-active .symptom-no,
  .symptom-entry.is-active .symptom-copy strong,
  .symptom-entry.is-active .symptom-link {
    color: var(--symptom-red);
  }

  .symptom-entry.is-active .symptom-link {
    transform: translate(2px, -2px);
  }

  /* PCではホバー中の行も控えめにハイライト（リンクであることを示す） */
  @media (min-width: 768px) and (hover: hover) {
    .symptom-entry:hover { background: rgba(239, 63, 55, .1); }
  }

  @media (max-width: 1023px) and (min-width: 768px) {
    .symptoms-explorer {
      grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
      gap: 24px;
      min-height: 620px;
    }

    .symptom-entry { min-height: 64px; }
    .symptom-copy strong { font-size: 13px; }
    .symptom-copy small { font-size: 9px; }
  }

  @media (max-width: 767px) {
    /* SPも2カラム：左にスケルトン、右に項目リスト。骨格を大きく見せる */
    .symptoms-explorer {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 10px;
      min-height: 0;
      align-items: center;
    }

    /* 暗パネルを骨格の縦横比に合わせて、上下のレターボックス（余白）をなくす＝骨格が枠いっぱいに */
    .symptoms-visual { height: auto; min-height: 0; aspect-ratio: 921 / 1708; }
    /* パネル＝骨格比のため、幅・高さ100%で満たす。ホットスポット（%指定）も画像に正確に一致する */
    .symptoms-body {
      position: absolute;
      inset: 0;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      transform: none;
    }
    .symptoms-list { width: 100%; }
    .symptom-entry { min-height: 60px; grid-template-columns: minmax(0, 1fr) 26px; }
    .symptom-trigger { grid-template-columns: 18px minmax(0, 1fr); gap: 5px; padding: 8px 2px; }
    .symptom-no { font-size: 8px; }
    .symptom-copy strong { font-size: 12px; }
    .symptom-copy small { font-size: 8px; }
    .symptom-link { font-size: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .symptom-hotspot.is-active { animation: none; opacity: .9; transform: translate(-50%, -50%) scale(1); }
    .symptom-entry,
    .symptom-trigger *,
    .symptom-link { transition-duration: 0s; }
  }
</style>
