---
// 回転する円形バッジ（ヒーロー写真に重ねる）
export interface Props { class?: string; }
const { class: className = '' } = Astro.props;
---
<div class={`pointer-events-none select-none ${className}`} aria-hidden="true">
  <svg viewBox="0 0 200 200" class="h-full w-full animate-spin-slow" style="filter: drop-shadow(0 0 14px rgba(247,245,240,0.9))">
    <defs>
      <path id="badge-circle" d="M 100,100 m -78,0 a 78,78 0 1,1 156,0 a 78,78 0 1,1 -156,0" />
    </defs>
    <circle cx="100" cy="100" r="98" fill="#1A1A1A" />
    <circle cx="100" cy="100" r="60" fill="none" stroke="#F7F5F0" stroke-width="1" opacity="0.5" />
    <text fill="#F7F7F4" font-size="13.5" font-weight="700" letter-spacing="2.5" font-family="'Archivo Black', sans-serif">
      <textPath href="#badge-circle">FIRST TRIAL ¥3,300 — PERSONAL STRETCH GIFU NAGARA —</textPath>
    </text>
    <text x="100" y="94" text-anchor="middle" fill="#F7F5F0" font-size="15" font-weight="700" font-family="'Noto Sans JP', sans-serif">初回限定</text>
    <text x="100" y="120" text-anchor="middle" fill="#92745E" font-size="21" font-weight="800" font-family="'Archivo Black', sans-serif">75%OFF</text>
  </svg>
</div>
