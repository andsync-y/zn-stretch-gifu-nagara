---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, PRICING, SAME_AS } from '../consts';

export interface Props {
  title: string;
  description: string;
  /** ルート相対パス（末尾スラッシュ任意）。canonical/OGに使用 */
  path?: string;
  ogImage?: string;
  /** 追加のJSON-LDオブジェクト配列（FAQPage / Service / Person / BreadcrumbList など） */
  jsonld?: Record<string, unknown>[];
}

const { title, description, path = '/', ogImage = '/images/ogp.svg', jsonld = [] } = Astro.props;

const canonical = new URL(path, Astro.site).href.replace(/\/$/, '') || Astro.site!.href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// 全ページ共通：LocalBusiness（NAP・営業時間・geo・sameAs）
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  '@id': new URL('/#localbusiness', Astro.site).href,
  name: SITE.brand,
  image: ogImageUrl,
  url: Astro.site!.href,
  telephone: SITE.tel,
  priceRange: PRICING.priceRange,
  address: {
    '@type': 'PostalAddress',
    postalCode: SITE.postalCode,
    addressRegion: SITE.addressRegion,
    addressLocality: SITE.addressLocality,
    streetAddress: SITE.streetAddress,
    addressCountry: 'JP',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.geo.lat,
    longitude: SITE.geo.lng,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: SITE.hoursOpen,
      closes: SITE.hoursClose,
    },
  ],
  sameAs: SAME_AS,
};

const schemas = [localBusiness, ...jsonld];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts（display=swap） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Playfair+Display:ital,wght@0,700;0,800;1,600&family=Cormorant+Garamond:ital,wght@1,500;1,600&family=Yomogi&display=swap"
      rel="stylesheet"
    />

    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-base">本文へスキップ</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
