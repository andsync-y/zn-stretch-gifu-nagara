---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MetaPixel from '../components/MetaPixel.astro';
import Clarity from '../components/Clarity.astro';
import { SITE, PRICING, SAME_AS } from '../consts';

export interface Props {
  title: string;
  description: string;
  /** ルート相対パス（末尾スラッシュ任意）。canonical/OGに使用 */
  path?: string;
  ogImage?: string;
  /** 追加のJSON-LDオブジェクト配列（FAQPage / Service / Person / BreadcrumbList など） */
  jsonld?: Record<string, unknown>[];
  /** 広告LP用：ヘッダー・フッター・共通モバイルCTAバーを出さない（計測タグは共通のまま） */
  minimal?: boolean;
}

const { title, description, path = '/', ogImage = '/images/ogp.jpg', jsonld = [], minimal = false } = Astro.props;

const canonical = new URL(path, Astro.site).href.replace(/\/$/, '') || Astro.site!.href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// 全ページ共通：LocalBusiness（NAP・営業時間・geo・sameAs）
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  '@id': new URL('/#localbusiness', Astro.site).href,
  name: SITE.brand,
  image: ogImageUrl,
  url: Astro.site!.href,
  telephone: SITE.tel,
  priceRange: PRICING.priceRange,
  address: {
    '@type': 'PostalAddress',
    postalCode: SITE.postalCode,
    addressRegion: SITE.addressRegion,
    addressLocality: SITE.addressLocality,
    streetAddress: SITE.streetAddress,
    addressCountry: 'JP',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.geo.lat,
    longitude: SITE.geo.lng,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: SITE.hoursOpen,
      closes: SITE.hoursClose,
    },
  ],
  sameAs: SAME_AS,
};

const schemas = [localBusiness, ...jsonld];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="JixZZeM4K7tFFx9IVTqz6vYa_RI331SoFx5i3ErhHaY" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts（display=swap） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@500;600;700;800&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- Meta（Facebook）ピクセル：PUBLIC_META_PIXEL_ID 設定時のみ出力 -->
    <MetaPixel />

    <!-- Microsoft Clarity（ヒートマップ・セッション録画） -->
    <Clarity />

    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-L88N21PDK8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-L88N21PDK8');

      // キーイベント計測：WEB予約（ホットペッパー）・LINE・電話のクリック
      document.addEventListener(
        'click',
        function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a) return;
          var href = a.getAttribute('href') || '';
          var name = '';
          if (href.indexOf('beauty.hotpepper.jp') !== -1) name = 'click_reserve';
          else if (href.indexOf('lin.ee') !== -1) name = 'click_line';
          else if (href.indexOf('tel:') === 0) name = 'click_tel';
          if (name) {
            gtag('event', name, {
              link_url: href,
              link_text: (a.textContent || '').trim().slice(0, 40),
              page_path: location.pathname,
            });
          }
        },
        { capture: true, passive: true }
      );
    </script>
    <!-- ページ固有のhead要素（noindex等）の差し込み口 -->
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:bg-ink focus:px-4 focus:py-2 focus:text-base">本文へスキップ</a>
    {!minimal && <Header />}
    <main id="main">
      <slot />
    </main>
    {!minimal && <Footer />}

    <!-- モバイル固定CTA（電話・WEB予約）。SPのみ表示。GA4のclick_tel/click_reserveは委譲で自動計測 -->
    {!minimal && (
      <nav class="mobile-cta" aria-label="電話・WEB予約">
        <a href={`tel:${SITE.telLink}`} class="mobile-cta-tel">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.3 1l-2.2 2.2z"/></svg>
          電話する
        </a>
        <a href={SITE.urls.line} target="_blank" rel="noopener" class="mobile-cta-line">
          LINE相談
        </a>
        <a href={SITE.urls.reserve} target="_blank" rel="noopener" class="mobile-cta-web">
          WEB予約 <span aria-hidden="true">↗</span>
        </a>
      </nav>
    )}

    <!--
      Metaピクセル：CV系CTAのクリック計測（サイト全体で1回）。
      既存GA4と同じくhref委譲で全CTAを自動計測。data-fb-eventが付いていればそれを優先。
      preventDefaultはせず外部遷移はそのまま通す（fbqはビーコン送信のためクリック時発火で概ね記録される）。
        HPB予約/クーポン → Schedule（HPB予約クリック）
        LINE            → Lead（LINE登録）
        電話(tel:)      → Contact（電話タップ）
    -->
    <script is:inline>
      document.addEventListener(
        'click',
        function (e) {
          if (typeof window.fbq !== 'function') return;
          var el = e.target && e.target.closest ? e.target.closest('[data-fb-event], a[href]') : null;
          if (!el) return;
          var ev = el.getAttribute('data-fb-event');
          var label = el.getAttribute('data-fb-label');
          if (!ev) {
            var href = (el.getAttribute('href') || '').toLowerCase();
            if (href.indexOf('lin.ee') !== -1 || href.indexOf('line.me') !== -1) { ev = 'Lead'; label = label || 'LINE登録'; }
            else if (href.indexOf('hotpepper.jp') !== -1) { ev = 'Schedule'; label = label || 'HPB予約クリック'; }
            else if (href.indexOf('tel:') === 0) { ev = 'Contact'; label = label || '電話タップ'; }
          }
          if (!ev) return;
          window.fbq('track', ev, { content_name: label || ev });
        },
        { capture: true, passive: true }
      );
    </script>
  </body>
</html>
