---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import PriceRows from '../components/PriceRows.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import { SITE, PHOTOS, LAST_UPDATED } from '../consts';

export interface QA { q: string; a: string; }
export interface Part { title: string; desc: string; }
export interface Related { label: string; desc: string; href: string; }

export interface Props {
  slug: string;
  /** お悩みラベル（例：肩こり） */
  label: string;
  /** Symptoms — 01 のような英字ラベル番号 */
  enNo: string;
  /** H1の枠囲み語＋接尾（例：{frame:'肩こり', tail:'でお悩みの方へ'}） */
  h1Frame: string;
  h1Tail: string;
  title: string;
  description: string;
  /** 冒頭リード */
  lead: string;
  /** マッサージ・整体との違い 本文 */
  compare: string;
  /** なぜ起こるセクション：見出し */
  whyHeading: string;
  /** 発生サイクル：タイトルと5ステップ＋戻り注記 */
  cycleTitle: string;
  cycleSteps: string[];
  cycleNote: string;
  /** 原因カード4つ */
  causes: string[];
  /** なぜ起こるの締め段落 */
  whyText: string;
  /** アプローチ2段落 */
  approach: string[];
  /** アプローチする主な部位（4件） */
  parts: Part[];
  /** 料金の一言 */
  priceLead: string;
  /** 予約CTAの見出し */
  reserveHeadline: string;
  faqs: QA[];
  related: Related[];
  serviceName: string;
}

const {
  slug, label, enNo, h1Frame, h1Tail, title, description, lead, compare,
  whyHeading, cycleTitle, cycleSteps, cycleNote, causes, whyText,
  approach, parts, priceLead, reserveHeadline, faqs, related, serviceName,
} = Astro.props;

const pagePath = `/symptoms/${slug}`;

const flow = [
  { no: '01', t: 'カウンセリング', d: '気になる部位や生活習慣を、個室でゆっくり伺います。' },
  { no: '02', t: '体の状態チェック', d: '姿勢や可動域を確認し、その日の内容を組み立てます。' },
  { no: '03', t: 'ザウルス式ストレッチ', d: '痛気持ちいい強さで、深層の筋肉までマンツーマンで伸ばします。' },
  { no: '04', t: 'アフターチェック', d: '施術前との違いを確認し、セルフケアをご提案します。' },
];

// JSON-LD: FAQPage（ページのFAQと一致）
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// JSON-LD: Service
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: serviceName,
  serviceType: 'パーソナルストレッチ',
  areaServed: { '@type': 'City', name: '岐阜市' },
  provider: { '@id': new URL('/#localbusiness', Astro.site).href },
  url: new URL(pagePath, Astro.site).href,
  description,
};

// JSON-LD: BreadcrumbList
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'お悩み別', item: new URL('/symptoms', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: label, item: new URL(pagePath, Astro.site).href },
  ],
};
---
<Base title={title} description={description} path={pagePath} jsonld={[faqSchema, serviceSchema, breadcrumbSchema]}>
  <!-- H1 + リード -->
  <section class="mx-auto max-w-content px-5 pb-24 pt-16 sm:px-10 sm:pb-32 sm:pt-[120px]">
    <div class="mb-10 sm:mb-14"><Breadcrumbs items={[{ label: 'トップ', href: '/' }, { label: 'お悩み別', href: '/symptoms' }, { label }]} /></div>
    <p class="en-label mb-8">Symptoms — {enNo}</p>
    <h1 class="mb-8 text-[32px] font-black leading-[1.45] sm:mb-10 sm:text-[56px]">
      <span class="frame-word">{h1Frame}</span>{h1Tail}
    </h1>
    <p class="mb-10 max-w-[900px] text-[15px] leading-[2.1] text-sub sm:mb-14 sm:text-[17px]">{lead}</p>
    <div class="rule-top max-w-[900px] pt-6 sm:pt-7">
      <h2 class="mb-3 text-[17px] font-black">マッサージ・整体との違い</h2>
      <p class="text-[15px] leading-[2.1] text-sub sm:text-base">{compare}</p>
    </div>
    <img src={PHOTOS.marquee1} alt={`${label}へのパーソナルストレッチの施術シーン`} width="1360" height="520" loading="lazy" decoding="async" class="mt-14 h-[280px] w-full object-cover sm:mt-[72px] sm:h-[520px]" style="object-position:center 50%" />
  </section>

  <!-- なぜ起こる -->
  <section class="border-t border-ink/15 bg-paper2 px-5 py-24 sm:px-10 sm:py-32">
    <div class="mx-auto max-w-content">
      <p class="en-label mb-8">Why</p>
      <h2 class="jp-title mb-12">{whyHeading}</h2>

      <!-- 発生サイクル図（デザインの円環をレスポンシブなステップ図に再構成） -->
      <div class="mb-16 border border-ink bg-paper px-6 py-10 sm:px-12 sm:py-14">
        <p class="mb-10 text-center text-[20px] font-black sm:text-[26px]">{cycleTitle}</p>
        <ol class="grid gap-6 sm:grid-cols-5 sm:gap-4">
          {cycleSteps.map((step, i) => (
            <li class="relative flex flex-col items-center text-center">
              <span class="mb-3 inline-flex h-8 w-8 items-center justify-center rounded-full bg-ink text-[13px] font-bold text-paper">{i + 1}</span>
              <span class="text-[15px] font-black leading-[1.7] sm:text-base">{step}</span>
              {i < cycleSteps.length - 1 && <span class="mt-3 text-[#C9C7C0] sm:absolute sm:-right-3 sm:top-1 sm:mt-0" aria-hidden="true">▼<span class="hidden sm:inline">︎</span></span>}
            </li>
          ))}
        </ol>
        <p class="mt-9 text-center text-[14px] text-muted sm:text-[15px]">
          <span class="mr-3 inline-block border-2 border-ink bg-paper px-3 py-0.5 text-[13px] font-black">慢性化</span>{cycleNote}
        </p>
      </div>

      <!-- 原因カード -->
      <ul class="grid grid-cols-2 gap-7 lg:grid-cols-4">
        {causes.map((c) => (
          <li class="border-b border-ink pb-6 text-center text-[15px] font-black leading-[1.8] sm:text-[17px]" set:html={c} />
        ))}
      </ul>

      <p class="mt-14 max-w-[900px] text-[15px] leading-[2.2] text-sub sm:mt-16 sm:text-base">{whyText}</p>
    </div>
  </section>

  <!-- アプローチ -->
  <section class="px-5 py-24 sm:px-10 sm:py-32">
    <div class="mx-auto max-w-content">
      <p class="en-label mb-8">Approach</p>
      <h2 class="jp-title mb-12">当店の{label}へのアプローチ</h2>
      <div class="grid items-start gap-12 lg:grid-cols-[1fr_380px] lg:gap-[88px]">
        <div>
          {approach.map((p) => <p class="mb-6 text-[15px] leading-[2.2] text-sub sm:text-base">{p}</p>)}
          <img src={PHOTOS.hero} alt={`${label}に関わる部位へのアプローチ（パーソナルストレッチ）`} width="940" height="380" loading="lazy" decoding="async" class="mt-6 h-[260px] w-full object-cover sm:h-[380px]" style="object-position:center 70%" />
        </div>
        <div>
          <h3 class="rule-top mb-8 pt-8 text-[21px] font-black sm:text-2xl">アプローチする主な部位</h3>
          <ul class="flex flex-col gap-8">
            {parts.map((p) => (
              <li class="flex items-baseline gap-5">
                <svg class="w-[26px] shrink-0 translate-y-1" viewBox="0 0 28 24" fill="none" aria-hidden="true"><path d="M4 13 L 11 20 L 25 4" stroke="#1A1A1A" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span class="leading-[1.9]">
                  <span class="block text-[19px] font-black sm:text-[22px]">{p.title}</span>
                  <span class="text-[15px] text-sub sm:text-[17px]">{p.desc}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 施術の流れ -->
  <section class="border-t border-ink/15 bg-paper2 px-5 py-24 sm:px-10 sm:py-32">
    <div class="mx-auto max-w-content">
      <p class="en-label mb-8">Flow</p>
      <h2 class="jp-title mb-14 sm:mb-[72px]">施術の流れ</h2>
      <ol class="grid gap-10 sm:grid-cols-2 sm:gap-12 lg:grid-cols-4">
        {flow.map((s) => (
          <li class="rule-top pt-7">
            <p class="mb-4 text-[13px] font-black tracking-[0.25em] text-faint">{s.no}</p>
            <h3 class="mb-3 text-[19px] font-black">{s.t}</h3>
            <p class="text-[15px] leading-[2] text-sub">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- お客様の声（掲載準備中・捏造しない） -->
  <section class="px-5 py-24 sm:px-10 sm:py-32">
    <div class="mx-auto max-w-content">
      <p class="en-label mb-8">Voice</p>
      <h2 class="jp-title mb-14">お客様の声</h2>
      <div class="rounded border border-dashed border-[#D9D9D5] px-8 py-14 text-center">
        <p class="mb-3 text-lg font-black text-sub">掲載準備中</p>
        <p class="text-[15px] leading-[2.1] text-sub">{label}でご来店いただいたお客様の声を、準備が整いしだい掲載します。<br />※実際のお客様の声のみを掲載します。</p>
      </div>
    </div>
  </section>

  <!-- 料金 -->
  <section class="border-t border-ink/15 bg-paper2 px-5 py-24 sm:px-10 sm:py-32">
    <div class="mx-auto grid max-w-content items-center gap-14 lg:grid-cols-2 lg:gap-[88px]">
      <div>
        <p class="en-label mb-8">Price</p>
        <h2 class="jp-title mb-6">まずは、初回3,300円から。</h2>
        <p class="mb-10 text-[15px] leading-[2.1] text-sub sm:text-base">{priceLead}</p>
        <div class="flex flex-wrap items-center gap-7">
          <a href={SITE.urls.reserve} target="_blank" rel="noopener" class="btn-ink-pill">初回価格で予約する</a>
          <a href={SITE.urls.line} target="_blank" rel="noopener" class="border-b border-sub pb-1 text-sm text-sub">LINEで相談</a>
        </div>
      </div>
      <div><PriceRows compact={true} /></div>
    </div>
  </section>

  <!-- FAQ -->
  <FAQ items={faqs} />

  <!-- 関連リンク -->
  <section class="border-t border-ink/15 bg-paper2 px-5 py-24 sm:px-10 sm:py-32">
    <div class="mx-auto max-w-content">
      <p class="en-label mb-8">Related</p>
      <h2 class="jp-title mb-14">こちらのお悩みも。</h2>
      <div class="rule-top">
        {related.map((r) => (
          <a href={r.href} class="group grid grid-cols-[1fr_32px] items-baseline gap-4 border-b border-line px-2 py-6 no-underline sm:grid-cols-[260px_1fr_32px] sm:gap-8 sm:py-7">
            <span class="text-[18px] font-black sm:text-xl">{r.label}</span>
            <span class="hidden text-[15px] leading-[2] text-sub sm:block">{r.desc}</span>
            <span class="text-right text-lg font-bold transition group-hover:text-amber-700" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <p class="mt-12"><a href="/" class="text-[15px] font-bold hover:text-amber-700">← トップページへ戻る</a></p>
      <p class="mt-8 text-xs text-muted">最終更新：{LAST_UPDATED}</p>
    </div>
  </section>

  <ReserveCTA title={reserveHeadline} />
</Base>
