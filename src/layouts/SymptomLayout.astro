---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import PriceHighlight from '../components/PriceHighlight.astro';
import ReserveCTA from '../components/ReserveCTA.astro';
import { SITE, BRAND, LAST_UPDATED } from '../consts';

export interface QA { q: string; a: string; }
export interface Related { label: string; href: string; }

export interface Props {
  slug: string;
  /** 症状の表示ラベル（例：肩こり） */
  label: string;
  /** H1・リード内の〔症状〕語 */
  symptomWord: string;
  title: string;
  description: string;
  /** 冒頭リード（結論を断言・効果は断定しない・300字以内） */
  lead: string;
  /** マッサージ/整体との比較（1文） */
  compareLine: string;
  /** 〔症状〕はなぜ起こる？ 段落配列 */
  causes: string[];
  /** 当店のアプローチ 段落配列 */
  approach: string[];
  /** アプローチで重点的にほぐす部位（箇条書き） */
  approachParts: string[];
  /** ブランドメソッドの文脈（1〜2文） */
  brandNote: string;
  /** お客様の声プレースホルダのキー（例：肩こり_1） */
  voiceKeys: string[];
  faqs: QA[];
  related: Related[];
  serviceName: string;
}

const {
  slug, label, symptomWord, title, description, lead, compareLine,
  causes, approach, approachParts, brandNote, voiceKeys, faqs, related, serviceName,
} = Astro.props;

const pagePath = `/symptoms/${slug}`;

// 施術の流れ（構造は共通）
const steps = [
  { no: '01', t: 'ご来店・受付', d: '完全個室へご案内します。人目を気にせず、リラックスしてお過ごしください。' },
  { no: '02', t: 'カウンセリング', d: 'お悩みや生活習慣、気になる部位を丁寧にうかがい、当日の内容をご提案します。' },
  { no: '03', t: 'パーソナルストレッチ', d: '担当トレーナーがマンツーマンで、お一人おひとりの状態に合わせて施術します。' },
  { no: '04', t: 'アフター・セルフケア', d: '当日の状態のご説明と、ご自宅でできるセルフケアのヒントをお伝えします。' },
];

// JSON-LD: FAQPage（ページのFAQと一致）
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// JSON-LD: Service
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: serviceName,
  serviceType: 'パーソナルストレッチ',
  areaServed: { '@type': 'City', name: '岐阜市' },
  provider: { '@id': new URL('/#localbusiness', Astro.site).href },
  url: new URL(pagePath, Astro.site).href,
  description,
};

// JSON-LD: BreadcrumbList
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'お悩み別', item: new URL('/symptoms', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: label, item: new URL(pagePath, Astro.site).href },
  ],
};
---
<Base
  title={title}
  description={description}
  path={pagePath}
  jsonld={[faqSchema, serviceSchema, breadcrumbSchema]}
>
  <Breadcrumbs items={[{ label: 'ホーム', href: '/' }, { label: 'お悩み別', href: '/symptoms' }, { label }]} />

  <!-- ヒーロー / リード -->
  <header class="container-x pt-8 pb-12">
    <p class="eyebrow">SYMPTOM</p>
    <h1 class="mt-3 max-w-3xl text-3xl font-black leading-tight sm:text-4xl">
      岐阜市長良で{symptomWord}のストレッチなら｜全力ストレッチ岐阜長良店
    </h1>
    <p class="prose-jp mt-6 max-w-2xl">{lead}</p>
    <p class="mt-5 max-w-2xl rounded-xl border border-line bg-offwhite px-5 py-4 text-sm text-charcoal">
      {compareLine}
    </p>
    <div class="mt-7 flex flex-col gap-3 sm:flex-row">
      <a href={SITE.urls.reserve} target="_blank" rel="noopener" class="btn-amber">初回75%OFFで予約する</a>
      <a href="/menu" class="btn-outline">料金を見る</a>
    </div>
  </header>

  <!-- 画像プレースホルダ -->
  <div class="container-x">
    <img
      src="/images/placeholder-symptom.svg"
      alt={`岐阜市長良の完全個室で${label}へのパーソナルストレッチを受けるイメージ`}
      width="1200" height="600" loading="lazy" decoding="async"
      class="w-full rounded-2xl border border-line bg-panel object-cover"
    />
    <p class="mt-2 text-xs text-charcoal/60">※画像は実店舗の写真に差し替え予定（{`{{店内写真}}`}）</p>
  </div>

  <!-- なぜ起こる -->
  <section class="container-x py-14" aria-labelledby="cause-h">
    <p class="eyebrow">MECHANISM</p>
    <h2 id="cause-h" class="mt-2 text-2xl font-bold sm:text-3xl">{symptomWord}はなぜ起こる？</h2>
    <div class="prose-jp mt-6 max-w-3xl">
      {causes.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <!-- 当店のアプローチ -->
  <section class="bg-offwhite">
    <div class="container-x py-14" aria-labelledby="approach-h">
      <p class="eyebrow">OUR APPROACH</p>
      <h2 id="approach-h" class="mt-2 text-2xl font-bold sm:text-3xl">当店の{label}へのアプローチ</h2>
      <div class="mt-8 grid gap-10 md:grid-cols-5">
        <div class="prose-jp md:col-span-3">
          {approach.map((p) => <p>{p}</p>)}
          <p class="text-sm text-charcoal/80">{brandNote}</p>
        </div>
        <div class="md:col-span-2">
          <div class="rounded-2xl border border-line bg-base p-6">
            <p class="font-bold">重点的にアプローチする部位の例</p>
            <ul class="mt-4 space-y-2 text-sm text-charcoal">
              {approachParts.map((x) => (
                <li class="flex gap-2"><span class="hand" aria-hidden="true">✓</span><span>{x}</span></li>
              ))}
            </ul>
            <p class="mt-4 text-xs text-charcoal/60">※内容はカウンセリングのうえ、お一人おひとりに合わせて調整します。効果には個人差があります。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 施術の流れ -->
  <section class="container-x py-14" aria-labelledby="flow-h">
    <p class="eyebrow">FLOW</p>
    <h2 id="flow-h" class="mt-2 text-2xl font-bold sm:text-3xl">施術の流れ</h2>
    <ol class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <li class="rounded-2xl border border-line p-6">
          <span class="hand text-2xl">{s.no}</span>
          <p class="mt-2 font-bold">{s.t}</p>
          <p class="mt-2 text-sm text-charcoal">{s.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- お客様の声（プレースホルダ・捏造禁止） -->
  <section class="bg-offwhite">
    <div class="container-x py-14" aria-labelledby="voice-h">
      <p class="eyebrow">VOICE</p>
      <h2 id="voice-h" class="mt-2 text-2xl font-bold sm:text-3xl">お客様の声</h2>
      <p class="mt-3 max-w-2xl text-sm text-charcoal">
        実際にご来店いただいた方の声を掲載予定です（現在準備中）。いただいた許可のうえで、順次掲載します。
      </p>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        {voiceKeys.map((k) => (
          <figure class="rounded-2xl border border-dashed border-line bg-base p-6">
            <figcaption class="text-xs font-bold text-amber-700">プレースホルダ</figcaption>
            <blockquote class="mt-2 text-charcoal">{`{{お客様の声_${k}}}`}</blockquote>
            <p class="mt-3 text-xs text-charcoal/60">※実際のお客様の声を許可のうえ掲載します（捏造しません）。</p>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 料金＋予約CTA -->
  <section class="container-x py-14" aria-labelledby="price-h">
    <p class="eyebrow">PRICE</p>
    <h2 id="price-h" class="mt-2 text-2xl font-bold sm:text-3xl">料金・ご予約</h2>
    <div class="mt-8"><PriceHighlight /></div>
  </section>

  <!-- FAQ -->
  <FAQ items={faqs} />

  <!-- 関連リンク -->
  <section class="container-x pb-8" aria-labelledby="rel-h">
    <p class="eyebrow">RELATED</p>
    <h2 id="rel-h" class="mt-2 text-xl font-bold">関連するお悩み・ご案内</h2>
    <ul class="mt-5 flex flex-wrap gap-3">
      {related.map((r) => (
        <li><a href={r.href} class="inline-flex rounded-full border border-line px-4 py-2 text-sm hover:border-ink/50">{r.label}</a></li>
      ))}
    </ul>
    <p class="mt-8 text-xs text-charcoal/60">最終更新：{LAST_UPDATED}</p>
  </section>

  <ReserveCTA />
</Base>
