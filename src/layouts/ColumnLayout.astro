---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReserveCTA from '../components/ReserveCTA.astro';

export interface Related { label: string; href: string; }
export interface Faq { q: string; a: string; }

export interface Props {
  slug: string;
  title: string;
  description: string;
  /** 記事の見出し（h1） */
  heading: string;
  /** 公開日（YYYY-MM-DD） */
  datePublished: string;
  /** 更新日（YYYY-MM-DD）。省略時は公開日と同じ */
  dateModified?: string;
  /** 記事に関連するお悩みページ等 */
  related: Related[];
  /** よくある質問（AIEO/LLMO・リッチリザルト用。3〜5問推奨） */
  faq?: Faq[];
  /** アイキャッチ画像のパス。OGP・Article構造化データにも使われる */
  image?: string;
  /** アイキャッチのalt（何が写っているかを具体的に。省略時は記事見出しから生成） */
  imageAlt?: string;
  /**
   * 画像の出典・クレジット。
   * 外部のフリー素材やAI生成画像を使う場合は必ず指定する（自店の写真なら不要）。
   */
  imageCredit?: string;
  /** アイキャッチの切り取り位置（CSSのobject-position）。縦長写真を横帯に収める際の調整用 */
  imagePosition?: string;
  /**
   * 監修者名。既定はトレーナーチーム名義。
   * 特定トレーナーの実名を出す場合は、実際にその人が内容を確認したときだけ指定すること
   * （実態のない監修者名はE-E-A-T上も逆効果になる）。
   */
  author?: string;
  /** 監修者のプロフィールページ。実名指定時に個人ページがあれば差し替える */
  authorUrl?: string;
}

const {
  slug, title, description, heading, datePublished, dateModified, related, faq = [],
  image = '/images/photos/hero.webp',
  imageAlt,
  imageCredit,
  imagePosition = 'center 45%',
  author = '全力ストレッチ岐阜長良店 体感軸調整トレーナーチーム',
  authorUrl = '/staff',
} = Astro.props;
const pagePath = `/column/${slug}`;
const eyecatchAlt = imageAlt ?? `${heading}｜岐阜市長良のパーソナルストレッチ専門店`;
// 既定はチーム名義なのでOrganization、実名を指定したらPersonとして出す
const isNamedAuthor = author !== '全力ストレッチ岐阜長良店 体感軸調整トレーナーチーム';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: heading,
  description,
  image: new URL(image, Astro.site).href,
  datePublished,
  dateModified: dateModified ?? datePublished,
  inLanguage: 'ja',
  author: {
    '@type': isNamedAuthor ? 'Person' : 'Organization',
    name: author,
    url: new URL(authorUrl, Astro.site).href,
    ...(isNamedAuthor
      ? { jobTitle: '体感軸調整トレーナー', worksFor: { '@id': new URL('/#localbusiness', Astro.site).href } }
      : {}),
  },
  // 記事が拠って立つ独自メソッド。AI・検索エンジンに専門性の裏付けを示す
  about: { '@id': new URL('/method#service', Astro.site).href },
  publisher: { '@id': new URL('/#localbusiness', Astro.site).href },
  mainEntityOfPage: new URL(pagePath, Astro.site).href,
};

const faqSchema = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: Astro.site!.href },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: new URL('/column', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: heading, item: new URL(pagePath, Astro.site).href },
  ],
};
---
<Base title={title} description={description} path={pagePath} ogImage={image} jsonld={[articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])]}>
  <article class="section-grid mx-auto max-w-content border-b border-ink/20 px-5 pb-24 pt-16 sm:px-10 sm:pb-32 sm:pt-[120px]">
    <div class="mb-10 sm:mb-14"><Breadcrumbs items={[{ label: 'トップ', href: '/' }, { label: 'コラム', href: '/column' }, { label: heading }]} /></div>
    <p class="en-label mb-8">Column</p>
    <h1 class="mb-6 max-w-[980px] text-[28px] font-black leading-[1.5] sm:text-[44px]">{heading}</h1>
    <p class="mb-8 text-[12px] tracking-[0.08em] text-muted sm:mb-10">公開日：{datePublished}{dateModified && dateModified !== datePublished ? `／更新日：${dateModified}` : ''}／執筆・監修：<a href={authorUrl} class="underline underline-offset-4">{author}</a></p>

    <figure class="mb-12 sm:mb-16">
      <img
        src={image}
        alt={eyecatchAlt}
        width="1360"
        height="620"
        fetchpriority="high"
        decoding="async"
        class="h-[220px] w-full max-w-[980px] object-cover sm:h-[380px]"
        style={`object-position:${imagePosition}`}
      />
      {imageCredit && (
        <figcaption class="mt-2 max-w-[980px] text-[11px] leading-[1.8] text-faint">{imageCredit}</figcaption>
      )}
    </figure>

    <div class="column-body max-w-[820px]">
      <slot />
    </div>

    <p class="rule-top mt-16 max-w-[820px] pt-5 text-[13px] leading-[1.9] text-muted">
      監修：<a href={authorUrl} class="font-bold underline underline-offset-4">{author}</a>（ZST協会認定／岐阜市長良・個室のパーソナルストレッチ専門店）<br />
      当店は独自メソッド<a href="/method" class="font-bold underline underline-offset-4">「体感軸調整法」</a>にもとづき、もむのではなく伸ばすアプローチを行っています。<br />
      ※本記事は一般的なセルフケアの情報であり、効果には個人差があります。強い痛みやしびれがある場合は医療機関にご相談ください。
    </p>

    {faq.length > 0 && (
      <div class="mt-16 max-w-[820px]">
        <h2 class="mb-6 text-[22px] font-black sm:text-[26px]">よくある質問</h2>
        <div class="rule-top">
          {faq.map((f) => (
            <div class="border-b border-line py-6">
              <p class="mb-2 text-[16px] font-black leading-[1.6] sm:text-[18px]">Q. {f.q}</p>
              <p class="text-[14px] leading-[2] text-sub sm:text-[15px]">A. {f.a}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    {related.length > 0 && (
      <div class="mt-14 max-w-[820px]">
        <h2 class="mb-6 text-[19px] font-black">あわせて読みたい・関連ページ</h2>
        <div class="rule-top">
          {related.map((r) => (
            <a href={r.href} class="group flex items-baseline justify-between gap-4 border-b border-line px-2 py-5 no-underline">
              <span class="text-[15px] font-bold sm:text-[17px]">{r.label}</span>
              <span class="text-lg font-bold transition group-hover:text-amber-700" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </article>

  <ReserveCTA title="セルフケアで追いつかない張りは、プロにおまかせください。" source={`column:${slug}`} />
</Base>

<style is:global>
  .column-body h2 {
    margin: 44px 0 18px;
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 900;
    line-height: 1.6;
    border-top: 1px solid #151719;
    padding-top: 22px;
  }
  .column-body h3 {
    margin: 30px 0 12px;
    font-size: clamp(17px, 1.9vw, 20px);
    font-weight: 900;
    line-height: 1.6;
  }
  .column-body p {
    margin: 0 0 18px;
    font-size: 15px;
    line-height: 2.1;
    color: #43494d;
  }
  .column-body ul,
  .column-body ol {
    margin: 0 0 22px;
    padding-left: 1.4em;
    font-size: 15px;
    line-height: 2;
    color: #43494d;
  }
  .column-body ul { list-style: disc; }
  .column-body ol { list-style: decimal; }
  .column-body li { margin-bottom: 6px; }
  .column-body strong { color: #151719; }
  .column-body a { font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
</style>
