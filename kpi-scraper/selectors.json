{
  "_comment": "店舗システムのページ構造定義。ダッシュボードはSPAで、#dashFromInput / #dashToInput（YYYY-MM-DD）に前週（月〜日）を入力して期間を反映させ、KPIテーブルの集計行（table_row）から週次値を取る。期間が正しく反映されたかは出力のfills_applied（入力した値）とperiod_labels（テーブル1列目のラベル）で確認できる。successCheckはログイン成功後のみ現れるログアウトボタン（モーダル内のpassword欄による誤検知対策）。",
  "configured": true,
  "login": {
    "url": "https://system.zn-stretch.com/",
    "userField": "",
    "passField": "",
    "submitButton": "",
    "successCheck": "button:has-text(\"ログアウト\")"
  },
  "pages": [
    {
      "name": "dashboard_week",
      "url": "https://system.zn-stretch.com/",
      "waitMs": 3000,
      "fills": [
        { "selector": "#dashFromInput", "value": "{week_start}" },
        { "selector": "#dashToInput", "value": "{week_end}" }
      ],
      "applyClick": "button:has-text(\"更新\")",
      "waitAfterFillMs": 3000
    },
    {
      "_comment": "勤務時間ページ。SPAなのでサイドバーの a.nav-item をクリックして開き、month入力に対象週の月を入れる。人件費の基礎（実働時間）を取るためだけに使い、担当者名は保存しない。",
      "name": "worktime_month",
      "url": "https://system.zn-stretch.com/",
      "waitMs": 3000,
      "navClick": "勤務時間",
      "fills": [{ "selector": "input[type='month']:visible", "value": "{month}" }],
      "waitAfterFillMs": 5000
    }
  ],
  "metrics": [
    { "key": "sales_total", "label": "売上（週計）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["売上", "新規販売数", "総来店数"], "column": "売上" },
    { "key": "total_visits", "label": "総来店数（週計）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["売上", "新規販売数", "総来店数"], "column": "総来店数" },
    { "key": "new_visits", "label": "新規来店数（週計）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["売上", "新規販売数", "総来店数"], "column": "新規来店数" },
    { "key": "new_ticket_sales", "label": "回数券新規販売本数（週計）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["売上", "新規販売数", "総来店数"], "column": "新規販売数" },
    { "key": "renewal_ticket_sales", "label": "回数券更新本数（週計）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["売上", "新規販売数", "総来店数"], "column": "更新販売数" },
    { "key": "next_reservations", "label": "次回予約数（週計）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["売上", "新規販売数", "総来店数"], "column": "次回予約数" },
    { "key": "shimei_count", "label": "指名数（週計）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["売上", "新規販売数", "総来店数"], "column": "指名数" },

    { "key": "new_churn", "label": "新規離客数（週計）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["新規離客", "新規来店", "更新来店"], "column": "新規離客" },
    { "key": "renewal_base", "label": "使い切り人数（週計・更新の母数）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["新規離客", "新規来店", "更新来店"], "column": "更新来店" },

    { "key": "new_ticket_rate", "label": "新規販売率（週）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["売上", "新規販売数", "総来店数"], "column": "新規販売率", "derive": ["new_ticket_sales", "new_visits"] },
    { "key": "renewal_ticket_rate", "label": "更新販売率（週）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["売上", "新規販売数", "総来店数"], "column": "更新販売率", "derive": ["renewal_ticket_sales", "renewal_base"] },
    { "key": "next_reservation_rate", "label": "次回予約率（週）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["売上", "新規販売数", "総来店数"], "column": "次回予約率", "derive": ["next_reservations", "total_visits"] },
    { "key": "new_churn_rate", "label": "新規離客率（週）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["新規離客", "新規来店", "更新来店"], "column": "新規率", "derive": ["new_churn", "new_visits"] },

    { "_comment": "担当別。合計では消える成約率のばらつきを見る。担当者名は保存しない（行の順番だけ）", "key": "by_staff", "label": "担当別（氏名は除外）", "page": "dashboard_week", "method": "table_rows", "tableMatch": ["担当", "新規販売率", "来店数"], "dropColumns": ["担当"] },
    { "_comment": "来店経路別。どの経路の新規が回数券につながっているか。経路名は個人情報ではないので残す", "key": "by_channel", "label": "来店経路別", "page": "dashboard_week", "method": "table_rows", "tableMatch": ["来店経路", "新規来店数", "販売率"] },

    { "_comment": "売上の内訳。2026-09-01の恒久ルール『施術＋回数券＋指名 が sales_total と一致するか検算する』を自動化するための3項目。一致しなければ払い戻し未反映を疑う。", "key": "sales_treatment", "label": "施術売上（週計）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["売上", "施術", "回数券", "指名"], "column": "施術" },
    { "key": "sales_ticket", "label": "回数券売上（週計）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["売上", "施術", "回数券", "指名"], "column": "回数券" },
    { "key": "sales_shimei", "label": "指名売上（週計）", "page": "dashboard_week", "method": "table_row", "tableMatch": ["売上", "施術", "回数券", "指名"], "column": "指名" },

    { "_comment": "稼働。⚠️このテーブルは期間指定(dashFrom/To)が効かず月次のまま返る（営業1,464h＝ベッド4台×約30.5日×12h）。週の値ではないので、年月ラベルごと保存してどの月かを明示する。", "key": "capacity_by_month", "label": "稼働（月次・年月ラベル付き）", "page": "dashboard_week", "method": "table_rows", "tableMatch": ["ベッド", "稼働", "営業"] },

    { "_comment": "勤務時間（月次）。人件費の基礎。基本給＝実働×最低保証1,600円なので、実働時間の合計が総支給のほぼ全部を説明する。担当者名は落とす（dropColumns）。", "key": "worktime_by_staff", "label": "勤務時間（月次・氏名は除外）", "page": "worktime_month", "method": "table_rows", "tableMatch": ["勤務時間", "勤務日数"], "dropColumns": ["担当", "備考"] }
  ]
}
